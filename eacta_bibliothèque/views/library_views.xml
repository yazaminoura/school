<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Loan Form View -->

    <!-- Book Tree View -->
<!-- Book Tree View -->
<record id="library_book_tree_view" model="ir.ui.view">
    <field name="name">library.book.tree</field>
    <field name="model">library.book</field>
    <field name="arch" type="xml">
        <tree>
            <field name="name"/>
            <field name="author"/>
            <field name="isbn"/>
            <field name="category_id"/> <!-- Add category column -->
            <field name="status"/>
            <field name="total_quantity"/>
            <field name="available_quantity"/>
        </tree>
    </field>
</record>

    <!-- Book Form View -->
<!-- Book Form View -->
<!-- 📚 Styled Book Form View -->
<record id="view_library_book_form" model="ir.ui.view">
        <field name="name">library.book.form.styled</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Titre du livre"/>
                        </h1>
                    </div>

                    <notebook>
                        <page string="Informations">
                            <group>
                                <group>
                                    <field name="author"/>
                                    <field name="isbn"/>
                                    <field name="category_id"/>
                                    <field name="status"/>
                                    <field name="loan_duration_days"/>
                                </group>
                                <group>
                                    <field name="image" widget="image" class="oe_avatar"/>
                                </group>
                            </group>
                            <h4>Description</h4>
                            <field name="description" placeholder="Description du livre..." nolabel="1"/>
                        </page>

                        <page string="Exemplaires">
                            <group>
                                <field name="total_quantity"/>
                                <field name="available_quantity" readonly="1"/>
                            </group>
                            <field name="barcode_ids">
                                <tree editable="bottom">
                                    <field name="barcode"/>
                                    <field name="icon_status" widget="html" readonly="1"/>
                                </tree>
                            </field>
                        </page>

                        <page string="Emprunts">
                            <field name="loan_ids">
                                <tree decoration-danger="is_overdue" decoration-success="returned">
                                    <field name="name"/>
                                    <field name="barcode_id"/>
                                    <field name="borrower_type"/>
                                    <field name="checkout_date"/>
                                    <field name="due_date"/>
                                    <field name="returned"/>
                                    <field name="is_overdue"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>    <!-- Book Kanban View -->
<!-- In the kanban template, add category information -->
<record id="library_book_kanban_view" model="ir.ui.view">
    <field name="name">library.book.kanban.compact</field>
    <field name="model">library.book</field>
    <field name="arch" type="xml">
        <kanban>
            <field name="name"/>
            <field name="author"/>
            <field name="category_id" options="{'no_create': False}" placeholder="Sélectionnez une catégorie..."/>
            <field name="image"/>
            <field name="is_available"/>
            <field name="available_quantity"/>
            <field name="total_quantity"/>
            <templates>
                <t t-name="kanban-box">
                    <div class="oe_kanban_global_click o_kanban_card d-flex align-items-center p-2 shadow-sm rounded">
                        <div class="me-2">
                            <img t-if="record.image.raw_value" t-att-src="kanban_image('library.book','image',record.id.raw_value)" style="height:60px; width:45px; object-fit:cover; border-radius:4px;"/>
                            <div t-else="" class="bg-light text-center d-flex align-items-center justify-content-center" style="height:60px; width:45px; border-radius:4px; font-size:18px;">📕</div>
                        </div>
                        <div class="flex-grow-1">
                            <strong><field name="name"/></strong><br/>
                            <small class="text-muted"><field name="author"/></small><br/>
                            <!-- Add category display -->
                            <t t-if="record.category_id.raw_value">
                                <small class="text-info"><field name="category_id"/></small><br/>
                            </t>

                        </div>
                        <div class="d-flex flex-column align-items-center justify-content-center text-muted" style="font-size:12px;">
    <div class="mb-1">
        <field name="available_quantity"/> / <field name="total_quantity"/>
    </div>
    <t t-if="record.is_available.raw_value">
        <span class="badge badge-success">Disponible</span>
    </t>
    <t t-else="">
        <span class="badge badge-danger">Indisponible</span>
    </t>
</div>

                    </div>
                </t>
            </templates>
        </kanban>
    </field>
</record>

    <!-- Book Search View -->
<!-- Book Search View -->
<record id="library_book_search_view" model="ir.ui.view">
    <field name="name">library.book.search</field>
    <field name="model">library.book</field>
    <field name="arch" type="xml">
        <search>
            <field name="name"/>
            <field name="author"/>
            <field name="isbn"/>
            <field name="category_id"/> <!-- Add category search field -->
            <field name="status"/>
            <filter name="available" string="Disponible" domain="[('is_available', '=', True)]"/>
            <filter name="on_loan" string="Emprunté" domain="[('status', '=', 'on_loan')]"/>
            <group expand="0" string="Group by">
                <filter name="group_by_category" string="Category" context="{'group_by': 'category_id'}"/>
            </group>
        </search>
    </field>
</record>




