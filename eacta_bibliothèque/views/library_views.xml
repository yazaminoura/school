<!-- Custom Actions for Loan Filters -->
<record id="action_all_loans" model="ir.actions.act_window">
    <field name="name">Tous les emprunts</field>
    <field name="res_model">library.loan</field>
    <field name="view_mode">kanban,tree,form</field>
    <field name="domain">[]</field>
</record>

<record id="action_active_loans" model="ir.actions.act_window">
    <field name="name">Emprunts actifs</field>
    <field name="res_model">library.loan</field>
    <field name="view_mode">kanban,tree,form</field>
    <field name="domain">[('returned','=',False)]</field>
</record>

<record id="action_overdue_loans" model="ir.actions.act_window">
    <field name="name">En retard</field>
    <field name="res_model">library.loan</field>
    <field name="view_mode">kanban,tree,form</field>
    <field name="domain">[('is_overdue','=',True),('returned','=',False)]</field>
</record>

<record id="action_returned_loans" model="ir.actions.act_window">
    <field name="name">Retournés</field>
    <field name="res_model">library.loan</field>
    <field name="view_mode">kanban,tree,form</field>
    <field name="domain">[('returned','=',True)]</field>
</record>

<record id="action_complete_return" model="ir.actions.act_window">
    <field name="name">Retour complet</field>
    <field name="res_model">library.loan</field>
    <field name="view_mode">kanban,tree,form</field>
    <field name="domain">[('complete_return','=',True)]</field>
</record>

<record id="action_incomplete_return" model="ir.actions.act_window">
    <field name="name">Retour incomplet</field>
    <field name="res_model">library.loan</field>
    <field name="view_mode">kanban,tree,form</field>
    <field name="domain">[('returned','=',True),('complete_return','=',False)]</field>
</record>

