    <!-- Updated Loan Form View -->
    <record id="view_library_loan_form" model="ir.ui.view">
        <field name="name">library.loan.form</field>
        <field name="model">library.loan</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" nolabel="1"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="category_id" required="1"/>
                            <field name="book_id" required="1"/>
                            <field name="barcode_id" required="1"
                                   domain="[('book_id', '=', book_id), ('is_available', '=', True)]"/>
                            <field name="borrower_type"/>
                            <field name="student_id" invisible="borrower_type != 'student'"/>
                            <field name="teacher_id" invisible="borrower_type != 'teacher'"/>
                        </group>
                        <group>
                            <field name="checkout_date" required="1"/>
                            <field name="due_date" required="1"/>
                            <field name="returned"/>
                            <field name="is_overdue" readonly="1"/>
                        </group>
                    </group>

                    <separator string="Responsables d'emprunt"/>
                    <group>
                        <group>
                            <field name="responsible_id" readonly="1"/>
                            <field name="processed_date" readonly="1"/>
                        </group>
                    </group>

                    <div invisible="not returned">
                        <separator string="Informations de retour"/>
                        <group>
                            <group>
                                <field name="return_date"/>
                                <field name="returned_barcode_id" readonly="1"/>
                            </group>
                            <group>
                                <field name="return_responsible_id" readonly="1"/>
                                <field name="was_overdue" readonly="1"/>
                                <field name="return_notes"/>
                            </group>
                        </group>
                    </div>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Updated Loan Tree View -->
    <record id="library_loan_tree_view" model="ir.ui.view">
        <field name="name">library.loan.tree</field>
        <field name="model">library.loan</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="book_id"/>
                <field name="barcode_id"/>
                <field name="borrower_type"/>
                <field name="checkout_date"/>
                <field name="due_date"/>
                <field name="return_date"/>
                <field name="returned"/>
                <field name="is_overdue"/>
                <field name="responsible_id"/>
            </tree>
        </field>
    </record>

    <!-- Updated Loan Kanban View -->
    <record id="view_library_loan_kanban" model="ir.ui.view">
        <field name="name">library.loan.kanban.professional</field>
        <field name="model">library.loan</field>
        <field name="arch" type="xml">
            <kanban class="o_loan_kanban">
                <field name="book_id"/>
                <field name="barcode_id"/>
                <field name="borrower_type"/>
                <field name="due_date"/>
                <field name="return_date"/>
                <field name="returned"/>
                <field name="is_overdue"/>
                <field name="checkout_date"/>
                <field name="complete_return"/>

                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_card loan-card shadow-sm rounded p-3 position-relative"
                             t-att-class="{
                                 'loan-card-returned': record.returned.raw_value,
                                 'loan-card-overdue': record.is_overdue.raw_value &amp;&amp; !record.returned.raw_value,
                                 'loan-card-active': !record.returned.raw_value &amp;&amp; !record.is_overdue.raw_value
                             }">

                            <div class="loan-status-ribbon position-absolute top-0 end-0">
                                <t t-if="record.returned.raw_value">
                                    <span class="badge bg-success rounded-0">RETOURNÉ</span>
                                </t>
                                <t t-elif="record.is_overdue.raw_value">
                                    <span class="badge bg-danger rounded-0">EN RETARD</span>
                                </t>
                                <t t-else="">
                                    <span class="badge bg-info rounded-0">ACTIF</span>
                                </t>
                            </div>

                            <div class="loan-book-info mb-3">
                                <div class="d-flex align-items-center">
                                    <div class="book-icon me-2">
                                        <i class="fa fa-book text-primary"></i>
                                    </div>
                                    <div class="book-info flex-grow-1">
                                        <h6 class="book-title mb-0 text-truncate fw-bold">
                                            <field name="book_id"/>
                                        </h6>
                                        <small class="text-muted">
                                            Code-barres: <field name="barcode_id"/>
                                        </small>
                                    </div>
                                </div>
                            </div>

                            <div class="loan-borrower-info mb-3">
                                <div class="d-flex align-items-center">
                                    <div class="borrower-icon me-2">
                                        <i class="fa fa-user text-secondary"></i>
                                    </div>
                                    <div class="borrower-info flex-grow-1">
                                        <span class="borrower-name text-truncate d-block small">
                                            <field name="borrower_type"/>
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <div class="loan-dates-info small">
                                <div class="row">
                                    <div class="col-6">
                                        <div class="text-muted">Emprunté le:</div>
                                        <div class="fw-bold">
                                            <field name="checkout_date" widget="date"/>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="text-muted">Retour prévu:</div>
                                        <div t-att-class="{
                                            'fw-bold text-danger': record.is_overdue.raw_value &amp;&amp; !record.returned.raw_value,
                                            'fw-bold': !record.is_overdue.raw_value || record.returned.raw_value
                                        }">
                                            <field name="due_date" widget="date"/>
                                        </div>
                                    </div>
                                </div>
                                <t t-if="record.returned.raw_value">
                                    <div class="return-date mt-2 pt-2 border-top">
                                        <div class="text-muted">Retourné le:</div>
                                        <div class="fw-bold text-success">
                                            <field name="return_date" widget="date"/>
                                        </div>
                                    </div>
                                </t>
                            </div>

                            <div class="loan-actions mt-3 pt-2 border-top">
                                <t t-if="!record.returned.raw_value">
                                    <button name="action_return_book" type="object" string="Retourner" class="btn btn-primary btn-sm w-100">
                                        <i class="fa fa-undo me-1"></i> Retourner
                                    </button>
                                </t>
                                <t t-else="">
                                    <button name="action_view_details" type="object" string="Détails" class="btn btn-outline-secondary btn-sm w-100">
                                        <i class="fa fa-eye me-1"></i> Détails
                                    </button>
                                </t>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Updated Loan Search View -->
    <record id="library_loan_search_view" model="ir.ui.view">
        <field name="name">library.loan.search</field>
        <field name="model">library.loan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="book_id"/>
                <field name="barcode_id"/>
                <filter string="Active" name="active_loans" domain="[('returned', '=', False)]"/>
                <filter string="Overdue" name="overdue_loans" domain="[('is_overdue', '=', True), ('returned', '=', False)]"/>
                <filter string="Returned" name="returned_loans" domain="[('returned', '=', True)]"/>
            </search>
        </field>
    </record>

