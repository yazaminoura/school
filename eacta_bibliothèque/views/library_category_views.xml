<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Category Tree View -->
    <record id="library_book_category_tree_view" model="ir.ui.view">
        <field name="name">library.book.category.tree</field>
        <field name="model">library.book.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="book_count" string="Total Books"/>
                <field name="available_book_count" string="Available Books"/>
            </list>
        </field>
    </record>

    <!-- Category Kanban View - MODERN STYLE -->
    <record id="library_book_category_kanban_view" model="ir.ui.view">
        <field name="name">library.book.category.kanban</field>
        <field name="model">library.book.category</field>
        <field name="arch" type="xml">
            <kanban default_group_by="id">
                <field name="name"/>
                <field name="id"/>
                <field name="book_count"/>
                <field name="available_book_count"/>
                <field name="book_names"/>

                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click o_kanban_card category-card bg-white rounded-3 shadow-sm border-0 p-0 overflow-hidden">
                            <!-- Category Header with modern gradient -->
                            <div class="category-header p-3 text-white position-relative">
                                <div class="position-absolute top-0 end-0 m-2">
                                    <t t-if="record.book_count.raw_value > 0">
                                        <span class="badge bg-white text-dark rounded-pill px-2 py-1">
                                            <field name="book_count"/> book(s)
                                        </span>
                                    </t>
                                </div>
                                <h5 class="category-name mb-0 fw-semibold text-truncate">
                                    <field name="name"/>
                                </h5>
                            </div>

                            <!-- Statistics Section -->
                            <div class="p-3">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div class="text-center">
                                        <div class="fs-5 fw-bold text-dark">
                                            <field name="book_count"/>
                                        </div>
                                        <div class="text-muted small mt-1">Total</div>
                                    </div>

                                    <div class="vr"></div>

                                    <div class="text-center">
                                        <div class="fs-5 fw-bold text-success">
                                            <field name="available_book_count"/>
                                        </div>
                                        <div class="text-muted small mt-1">Available</div>
                                    </div>

                                    <div class="vr"></div>

                                    <div class="text-center">
                                        <div class="fs-5 fw-bold text-warning">
                                            <span t-esc="record.book_count.raw_value - record.available_book_count.raw_value"/>
                                        </div>
                                        <div class="text-muted small mt-1">Borrowed</div>
                                    </div>
                                </div>

                                <!-- Availability Status -->
                                <div class="availability-status mb-3">
                                    <t t-if="record.book_count.raw_value > 0">
                                        <div class="progress" style="height: 8px;">
                                            <div t-attf-class="progress-bar #{record.available_book_count.raw_value > 0 ? 'bg-success' : 'bg-secondary'}"
                                                 t-attf-style="width: #{(record.available_book_count.raw_value / record.book_count.raw_value) * 100}%">
                                            </div>
                                        </div>
                                        <div class="d-flex justify-content-between mt-1 small text-muted">
                                            <span>
                                                <t t-esc="Math.round((record.available_book_count.raw_value / record.book_count.raw_value) * 100)"/>% available
                                            </span>
                                            <span>
                                                <t t-esc="record.available_book_count.raw_value"/>/<t t-esc="record.book_count.raw_value"/>
                                            </span>
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <div class="text-center py-2 text-muted">
                                            <i class="fa fa-inbox me-1"></i> No books in category
                                        </div>
                                    </t>
                                </div>
                            </div>

                            <!-- View Books Button -->
                            <div class="px-3 pb-3">
                                <button class="btn btn-outline-primary w-100 d-flex align-items-center justify-content-center">
                                    <i class="fa fa-book-open me-2"></i> View Books
                                </button>
                            </div>
                        </div>
                    </t>
                </templates>

                <!-- CSS Styling -->
                <style>
                    .category-card {
                        transition: all 0.2s ease;
                    }

                    .category-card:hover {
                        transform: translateY(-5px);
                        box-shadow: 0 12px 20px rgba(0, 0, 0, 0.1) !important;
                    }

                    .category-header {
                        min-height: 80px;
                        display: flex;
                        align-items: center;
                    }

                    .progress {
                        border-radius: 10px;
                        overflow: hidden;
                    }

                    .progress-bar {
                        border-radius: 10px;
                    }
                </style>
            </kanban>
        </field>
    </record>

    <!-- Category Form View - MODERN DESIGN -->
    <record id="view_library_book_category_form" model="ir.ui.view">
        <field name="name">library.book.category.form</field>
        <field name="model">library.book.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <!-- Header Section -->
                    <div class="oe_title mb-4">
                        <label for="name" class="form-label mb-1 text-muted small">Category Name</label>
                        <h1>
                            <field name="name" placeholder="Enter category name" class="border-0 fs-3 fw-bold p-0"/>
                        </h1>
                    </div>

                    <!-- Statistics Cards -->
                    <div class="row mb-4">
                        <div class="col-md-4">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-body text-center p-4">
                                    <div class="text-primary mb-2">
                                        <i class="fa fa-book fa-2x" title="Livres" aria-label="Livres" role="img"></i>
                                    </div>
                                    <h3 class="fw-bold text-dark mb-1">
                                        <field name="book_count"/>
                                    </h3>
                                    <p class="text-muted mb-0">Total Books</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-body text-center p-4">
                                    <div class="text-success mb-2">
                                        <i class="fa fa-check-circle fa-2x" title="Disponible" aria-label="Disponible" role="img"></i>
                                    </div>
                                    <h3 class="fw-bold text-dark mb-1">
                                        <field name="available_book_count"/>
                                    </h3>
                                    <p class="text-muted mb-0">Available Now</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-body text-center p-4">
                                    <div class="text-warning mb-2">
                                        <i class="fa fa-users fa-2x" title="Empruntés" aria-label="Empruntés" role="img"></i>
                                    </div>
                                    <h3 class="fw-bold text-dark mb-1">
                                        <field name="book_count"/> - <field name="available_book_count"/>
                                    </h3>
                                    <p class="text-muted mb-0">Currently Borrowed</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Books in this category -->
                    <notebook>
                        <page string="Books" name="books_tab">
                            <div class="alert alert-light border mb-4" role="status">
                                <div class="d-flex align-items-center">
                                    <i class="fa fa-info-circle text-primary me-2" title="Info" aria-label="Info" role="img"></i>
                                     <div>
                                        <strong class="d-block">Category Contents</strong>
                                        <small class="text-muted">
                                            This section shows all books belonging to the category :
                                            <span class="fw-bold text-dark"><field name="name"/></span>
                                        </small>
                                    </div>
                                    <!--
                                    <div class="ms-auto">
                                        <span class="badge bg-primary me-2">
                                            Total: <field name="book_count"/>
                                        </span>
                                        <span class="badge bg-success">
                                            Available: <field name="available_book_count"/>
                                        </span>
                                    </div>-->
                                </div>
                            </div>

                            <field name="book_ids" mode="list" nolabel="1">
                                <list editable="bottom" class="o_kanban_view">
                                    <header>
                                        <button string="Add Book" type="action"
                                                name="%(action_library_book)d"
                                                context="{'default_category_id': parent.id}"
                                                class="btn btn-primary"/>
                                    </header>
                                    <field name="name"/>
                                    <field name="author"/>
                                    <field name="isbn"/>
                                    <field name="status"/>
                                    <field name="total_quantity" string="Total"/>
                                    <field name="available_quantity" string="Available"/>
                                    <field name="is_available" invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Category Search View -->
    <record id="library_book_category_search_view" model="ir.ui.view">
        <field name="name">library.book.category.search</field>
        <field name="model">library.book.category</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="with_books" string="With Books" domain="[('book_ids', '!=', False)]"/>
                <filter name="without_books" string="Without Books" domain="[('book_ids', '=', False)]"/>
                <filter name="with_available_books" string="With Available Books"
                        domain="[('book_ids.available_quantity', '>', 0)]"/>
            </search>
        </field>
    </record>
