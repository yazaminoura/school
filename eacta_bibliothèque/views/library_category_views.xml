<!-- In library_category_views.xml, update borrower tree view -->
<record id="library_borrower_tree_view" model="ir.ui.view">
    <field name="name">library.borrower.tree</field>
    <field name="model">library.borrower</field>
    <field name="arch" type="xml">
        <list>
            <field name="name"/>
            <field name="borrower_type"/>
            <field name="email"/>
            <field name="active_loans_count"/>
            <field name="overdue_loans_count"/>
            <field name="total_loans_count"/>
        </list>
    </field>
</record>

<!-- Update borrower form view -->
<record id="view_library_borrower_form" model="ir.ui.view">
    <field name="name">library.borrower.form</field>
    <field name="model">library.borrower</field>
    <field name="arch" type="xml">
        <form>
            <sheet>
                <div class="oe_title">
                    <h1>
                        <field name="name" readonly="1" nolabel="1"/>
                    </h1>
                </div>

                <group>
                    <group>
                        <field name="borrower_type" required="1"/>
                        <field name="student_id" invisible="borrower_type != 'student'" required="0" readonly="1"/>
                        <field name="teacher_id" invisible="borrower_type != 'teacher'" required="0" readonly="1"/>
                    </group>
                    <group>
                        <field name="email" readonly="1"/>
                        <field name="active_loans_count" readonly="1"/>
                        <field name="overdue_loans_count" readonly="1"/>
                        <field name="total_loans_count" readonly="1"/>
                    </group>
                </group>

                <notebook>
                    <page string="Historique des emprunts">
                        <field name="loan_ids">
                            <list decoration-danger="is_overdue" decoration-success="returned">
                                <field name="book_id"/>
                                <field name="barcode_id"/>
                                <field name="checkout_date"/>
                                <field name="due_date"/>
                                <field name="return_date"/>
                                <field name="returned"/>
                                <field name="is_overdue"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </sheet>
            <div class="oe_chatter">
                <field name="message_follower_ids" widget="mail_followers"/>
                <field name="activity_ids" widget="mail_activity"/>
                <field name="message_ids" widget="mail_thread"/>
            </div>
        </form>
    </field>
</record>
    <record id="library_borrower_search_view" model="ir.ui.view">
        <field name="name">library.borrower.search</field>
        <field name="model">library.borrower</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="email"/>
                <field name="borrower_type"/>
                <filter name="students" string="Élèves" domain="[('borrower_type', '=', 'student')]"/>
                <filter name="teachers" string="Professeurs" domain="[('borrower_type', '=', 'teacher')]"/>
                <filter name="with_active_loans" string="Avec emprunts actifs" domain="[('active_loans_count', '>', 0)]"/>
                <filter name="with_overdue_loans" string="Avec emprunts en retard" domain="[('overdue_loans_count', '>', 0)]"/>
                <group expand="0" string="Group by">
                    <filter name="group_by_type" string="Type d'emprunteur" context="{'group_by': 'borrower_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Borrower Action -->
    <record id="action_library_borrower" model="ir.actions.act_window">
        <field name="name">Emprunteurs</field>
        <field name="res_model">library.borrower</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_group_by_type': 1}</field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_library_borrower" name="Emprunteurs" parent="menu_library_root" action="action_library_borrower" sequence="30"/>
<!-- [file content end] -->

    <!-- Category Action -->
    <record id="action_library_book_category" model="ir.actions.act_window">
        <field name="name">Book Categories</field>
        <field name="res_model">library.book.category</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <!-- Menu Item for Categories -->
    <menuitem id="menu_library_book_category" name="Categories" parent="menu_library_root" action="action_library_book_category" sequence="40"/>
</odoo>