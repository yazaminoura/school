<!-- Borrower Kanban View -->
<record id="library_borrower_kanban_view" model="ir.ui.view">
    <field name="name">library.borrower.kanban</field>
    <field name="model">library.borrower</field>
    <field name="arch" type="xml">
        <kanban default_group_by="borrower_type">
            <field name="name"/>
            <field name="borrower_type"/>
            <field name="email"/>
            <field name="active_loans_count"/>
            <field name="overdue_loans_count"/>
            <field name="total_loans_count"/>

            <templates>
                <t t-name="card">
                    <div class="oe_kanban_global_click o_kanban_card borrower-card bg-white rounded-lg shadow-sm border-0 p-3 position-relative">
                        <!-- Status indicator -->
                        <div class="position-absolute top-0 end-0 mt-2 me-2">
                            <t t-if="record.overdue_loans_count.raw_value > 0">
                                <span class="badge bg-danger rounded-pill">⚠️ En retard</span>
                            </t>
                            <t t-elif="record.active_loans_count.raw_value > 0">
                                <span class="badge bg-warning rounded-pill">📚 Actif</span>
                            </t>
                            <t t-else="">
                                <span class="badge bg-success rounded-pill">✅ Libre</span>
                            </t>
                        </div>

                        <!-- Header with borrower name -->
                        <div class="borrower-header mb-3">
                            <div class="d-flex align-items-center">
                                <div class="borrower-avatar me-3">
                                    <t t-if="record.borrower_type.raw_value == 'student'">
                                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; font-size: 18px;">
                                            🎓
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <div class="bg-info text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; font-size: 18px;">
                                            👨‍🏫
                                        </div>
                                    </t>
                                </div>
                                <div class="borrower-info flex-grow-1">
                                    <h6 class="borrower-name mb-0 fw-bold text-truncate" style="max-width: 200px;">
                                        <field name="name"/>
                                    </h6>
                                    <small class="text-muted">
                                        <field name="borrower_type"/>
                                    </small>
                                </div>
                            </div>
                        </div>

                        <!-- Email -->
                        <div class="borrower-email mb-3" t-if="record.email.raw_value">
                            <div class="d-flex align-items-center">
                                <i class="fa fa-envelope text-muted me-2" style="font-size: 12px;" title="Email" aria-label="Email" role="img"></i>
                                <small class="text-truncate" style="max-width: 200px;">
                                    <field name="email"/>
                                </small>
                            </div>
                        </div>

                        <!-- Loan statistics -->
                        <div class="loan-stats">
                            <div class="stats-grid">
                                <!-- Active loans -->
                                <div class="stat-item text-center">
                                    <div class="stat-number text-primary fw-bold">
                                        <field name="active_loans_count"/>
                                    </div>
                                    <div class="stat-label text-muted" style="font-size: 11px;">
                                        Actifs
                                    </div>
                                </div>

                                <!-- Overdue loans -->
                                <div class="stat-item text-center">
                                    <div class="stat-number text-danger fw-bold">
                                        <field name="overdue_loans_count"/>
                                    </div>
                                    <div class="stat-label text-muted" style="font-size: 11px;">
                                        En retard
                                    </div>
                                </div>

                                <!-- Total loans -->
                                <div class="stat-item text-center">
                                    <div class="stat-number text-dark fw-bold">
                                        <field name="total_loans_count"/>
                                    </div>
                                    <div class="stat-label text-muted" style="font-size: 11px;">
                                        Total
                                    </div>
                                </div>
                            </div>

                            <!-- Progress bar -->
                            <div class="progress mt-2" style="height: 6px;">
                                <div class="progress-bar bg-primary"
                                     t-att-style="'width: ' + (record.total_loans_count.raw_value > 0 ? (record.active_loans_count.raw_value / record.total_loans_count.raw_value * 100) : 0) + '%;'">
                                </div>
                                <div class="progress-bar bg-danger"
                                     t-att-style="'width: ' + (record.total_loans_count.raw_value > 0 ? (record.overdue_loans_count.raw_value / record.total_loans_count.raw_value * 100) : 0) + '%;'">
                                </div>
                            </div>

                            <!-- Progress labels -->
                            <div class="progress-labels d-flex justify-content-between mt-1">
                                <small class="text-muted">
                                    <t t-esc="Math.round(record.total_loans_count.raw_value > 0 ? (record.active_loans_count.raw_value / record.total_loans_count.raw_value * 100) : 0)"/>% actifs
                                </small>
                                <small class="text-muted">
                                    <t t-esc="Math.round(record.total_loans_count.raw_value > 0 ? (record.overdue_loans_count.raw_value / record.total_loans_count.raw_value * 100) : 0)"/>% retard
                                </small>
                            </div>
                        </div>

                        <!-- Quick actions -->
                        <div class="borrower-actions mt-3 pt-2 border-top">
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-outline-primary flex-fill" name="open_loans" type="object">
                                    <i class="fa fa-eye me-1"></i> Voir
                                </button>
                                <button class="btn btn-sm btn-outline-secondary" name="action_view_loans" type="object" title="Emprunts" aria-label="Emprunts">
                                    <i class="fa fa-book me-1" title="Emprunts" aria-label="Emprunts" role="img"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </t>
            </templates>

            <!-- CSS Styling -->
            <style>
                .borrower-card {
                    transition: all 0.3s ease;
                    border: 1px solid #e9ecef;
                    border-radius: 12px;
                    overflow: hidden;
                }

                .borrower-card:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
                    border-color: #007bff;
                }

                .borrower-header {
                    border-bottom: 1px solid #f8f9fa;
                    padding-bottom: 12px;
                }

                .borrower-name {
                    color: #2c3e50;
                    font-size: 14px;
                }

                .stats-grid {
                    display: grid;
                    grid-template-columns: repeat(3, 1fr);
                    gap: 8px;
                    margin-bottom: 12px;
                }

                .stat-item {
                    padding: 8px;
                    background: #f8f9fa;
                    border-radius: 8px;
                    border: 1px solid #e9ecef;
                }

                .stat-number {
                    font-size: 16px;
                    line-height: 1.2;
                }

                .stat-label {
                    font-size: 11px;
                    text-transform: uppercase;
                    letter-spacing: 0.5px;
                }

                .progress {
                    background: #e9ecef;
                    border-radius: 10px;
                    overflow: hidden;
                }

                .progress-bar {
                    transition: width 0.3s ease;
                }

                .progress-labels {
                    font-size: 10px;
                }

                .borrower-actions .btn {
                    border-radius: 8px;
                    font-size: 12px;
                    padding: 4px 8px;
                }

                /* Responsive design */
                @media (max-width: 768px) {
                    .borrower-card {
                        margin-bottom: 12px;
                    }

                    .stats-grid {
                        gap: 4px;
                    }

                    .stat-item {
                        padding: 6px;
                    }

                    .stat-number {
                        font-size: 14px;
                    }
                }

                /* Group headers styling */
                .o_kanban_group {
                    background: #f8f9fa;
                    border-radius: 12px;
                    margin: 8px;
                }

                .o_kanban_header {
                    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                    color: white;
                    border-radius: 12px 12px 0 0;
                    padding: 15px;
                }

                .o_kanban_header_title {
                    font-weight: 600;
                    font-size: 14px;
                }
            </style>
        </kanban>
    </field>
</record>
