<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="action_library_dashboard" model="ir.actions.client">
        <field name="name">Bibliothèque</field>
        <field name="tag">eacta_bibliotheque.dashboard</field>
    </record>

    <menuitem id="menu_library_root" name="Bibliothèque" sequence="55"
              action="action_library_dashboard"
              web_icon="eacta_bibliothèque,static/description/icon.png"
              groups="eacta_bibliothèque.group_eacta_library_user,eacta_school.group_eacta_school_user"/>
    <menuitem id="menu_library_dashboard" name="Tableau de bord" parent="menu_library_root"
              action="action_library_dashboard" sequence="1"/>

    <menuitem id="menu_library_circulation" name="Prêts" parent="menu_library_root" sequence="10"/>
    <menuitem id="menu_library_loan" name="Emprunts" parent="menu_library_circulation"
              action="action_library_loan" sequence="10"/>
    <menuitem id="menu_library_overdue" name="Retards" parent="menu_library_circulation"
              action="action_overdue_loans" sequence="20"/>
    <menuitem id="menu_library_borrower" name="Lecteurs" parent="menu_library_circulation"
              action="action_library_borrower" sequence="30"/>

    <menuitem id="menu_library_catalog" name="Catalogue" parent="menu_library_root" sequence="20"/>
    <menuitem id="menu_library_book" name="Livres" parent="menu_library_catalog"
              action="action_library_book" sequence="10"/>
    <menuitem id="menu_library_copy" name="Exemplaires" parent="menu_library_catalog"
              action="action_library_copy" sequence="20"/>

    <menuitem id="menu_library_reporting" name="Analyse" parent="menu_library_root" sequence="80"/>
    <menuitem id="menu_library_loan_analysis" name="Analyse des emprunts" parent="menu_library_reporting"
              action="action_library_loan_analysis" sequence="10"/>

    <menuitem id="menu_library_config" name="Configuration" parent="menu_library_root" sequence="100"
              groups="eacta_bibliothèque.group_eacta_library_manager"/>
    <menuitem id="menu_library_settings" name="Réglages" parent="menu_library_config"
              action="action_library_settings" sequence="1" groups="base.group_system"/>
    <menuitem id="menu_library_book_category" name="Catégories" parent="menu_library_config"
              action="action_library_book_category" sequence="10"/>

</odoo>
