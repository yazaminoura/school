# =============================================================================
# NR School - Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# DO NOT commit real secrets or credentials to source control.
# =============================================================================

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=odoo
DB_PASSWORD=your_secure_db_password_here
DB_NAME=nrschool_prod

# Odoo Master Password (used for database management)
ODOO_ADMIN_PASSWORD=your_super_admin_master_password_here

# Odoo Server Configuration
ODOO_PORT=8069
ODOO_LONGPOLLING_PORT=8072
ODOO_WORKERS=4
ODOO_MAX_CRON_THREADS=2

# Limits & Timeouts
LIMIT_MEMORY_HARD=2684354560
LIMIT_MEMORY_SOFT=2147483648
LIMIT_TIME_CPU=120
LIMIT_TIME_REAL=240

# Addons Paths (comma-separated absolute paths)
ADDONS_PATH=/opt/odoo/odoo-server/addons,/opt/odoo/custom-addons/school

# Mail Server Configuration (SMTP)
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@school.ma
SMTP_PASSWORD=your_smtp_password_here
SMTP_SSL=False

# Backup & Storage
BACKUP_DIR=/var/backups/odoo
DATA_DIR=/var/lib/odoo
