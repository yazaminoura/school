<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_library_loan" model="ir.sequence">
            <field name="name">Emprunts bibliothèque</field>
            <field name="code">library.loan</field>
            <field name="prefix">EMP/%(year)s/</field>
            <field name="padding">4</field>
        </record>

        <record id="ir_cron_library_overdue" model="ir.cron">
            <field name="name">Bibliothèque : contrôle des retards</field>
            <field name="model_id" ref="model_library_loan"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_overdue()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="email_template_library_loan_overdue" model="mail.template">
            <field name="name">Bibliothèque : Relance d'emprunt en retard</field>
            <field name="model_id" ref="model_library_loan"/>
            <field name="subject">Rappel : Retard de restitution de livre - {{ object.book_id.name }}</field>
            <field name="email_from">{{ (object.responsible_id.email_formatted or user.email_formatted or '') }}</field>
            <field name="email_to">{{ (object.student_id.parent_ids[:1].email or object.student_id.email or object.teacher_id.email or '') }}</field>
            <field name="description">Email automatique envoyé pour relancer un emprunteur dont le livre est en retard</field>
            <field name="body_html" type="html">
<div style="font-family: 'Segoe UI', Arial, sans-serif; font-size: 14px; color: #333333; line-height: 1.5;">
    <p>Bonjour <t t-out="object.borrower_name"/>,</p>
    <p>Nous vous informons que le prêt du document suivant est arrivé à échéance et n'a pas encore été restitué :</p>
    <div style="background-color: #F8FAFC; border-left: 4px solid #EF4444; padding: 12px 16px; margin: 16px 0; border-radius: 4px;">
        <p style="margin: 0; font-size: 15px; font-weight: bold; color: #0F172A;" t-out="object.book_id.name"/>
        <p style="margin: 4px 0 0 0; color: #64748B;">Date d'emprunt : <t t-out="object.checkout_date"/></p>
        <p style="margin: 4px 0 0 0; color: #DC2626; font-weight: bold;">Date limite de retour : <t t-out="object.due_date"/> (<t t-out="object.days_late"/> jour(s) de retard)</p>
        <t t-if="object.fine_amount &gt; 0">
            <p style="margin: 4px 0 0 0; color: #B91C1C;">Pénalité de retard actuelle : <t t-out="object.fine_amount"/> <t t-out="object.currency_id.symbol or 'DH'"/></p>
        </t>
    </div>
    <p>Merci de bien vouloir rapporter cet ouvrage à la bibliothèque dès que possible afin de permettre aux autres élèves d'y avoir accès.</p>
    <p style="margin-top: 24px;">Cordialement,<br/>
    <strong>Le service Bibliothèque - NR School</strong></p>
</div>
            </field>
        </record>

    </data>
</odoo>
