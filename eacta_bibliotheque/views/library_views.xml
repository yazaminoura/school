<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ============================== LIVRES ============================== -->
    <record id="library_book_tree_view" model="ir.ui.view">
        <field name="name">library.book.list</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <list string="Livres" sample="1" decoration-muted="not is_available">
                <field name="name"/>
                <field name="author"/>
                <field name="category_id" optional="show"/>
                <field name="isbn" optional="show"/>
                <field name="publisher" optional="hide"/>
                <field name="publication_year" optional="hide"/>
                <field name="language" optional="hide"/>
                <field name="shelf_location" optional="show"/>
                <field name="total_quantity" string="Ex." sum="Total"/>
                <field name="available_quantity" string="Dispo." sum="Total"/>
                <field name="is_available" column_invisible="1"/>
                <field name="status" widget="badge" decoration-success="status == 'available'"
                       decoration-warning="status == 'on_loan'"/>
            </list>
        </field>
    </record>

    <record id="view_library_book_form" model="ir.ui.view">
        <field name="name">library.book.form</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <form string="Livre">
                <header>
                    <button name="action_borrow" string="Prêter ce livre" type="object" class="btn-primary"
                            icon="fa-share" invisible="not is_available"/>
                    <button name="action_print_labels" string="Étiquettes" type="object" icon="fa-barcode"
                            invisible="not total_quantity"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_copies" type="object" class="oe_stat_button" icon="fa-clone">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="available_quantity"/> / <field name="total_quantity" readonly="1"/>
                                </span>
                                <span class="o_stat_text">Disponibles</span>
                            </div>
                        </button>
                        <button name="action_view_loans" type="object" class="oe_stat_button" icon="fa-exchange">
                            <field name="loan_count" widget="statinfo" string="Emprunts"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archivé" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <field name="is_available" invisible="1"/>
                    <field name="image" widget="image" class="oe_avatar o_library_cover"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Titre du livre"/></h1>
                        <h4 class="text-muted"><field name="author" placeholder="Auteur"/></h4>
                    </div>
                    <group>
                        <group string="Catalogue">
                            <field name="category_id"/>
                            <field name="isbn" placeholder="978-…"/>
                            <field name="publisher"/>
                            <field name="publication_year" options="{'format': false}"/>
                            <field name="edition"/>
                        </group>
                        <group string="Fonds">
                            <field name="language"/>
                            <field name="pages"/>
                            <field name="shelf_location" placeholder="ex : B-12"/>
                            <field name="total_quantity"/>
                            <field name="loan_duration_days"/>
                            <field name="replacement_cost"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Exemplaires" name="copies" icon="fa-clone">
                            <field name="barcode_ids" context="{'default_book_id': id}">
                                <list editable="bottom" decoration-muted="state == 'lost'"
                                      decoration-warning="state == 'on_loan'">
                                    <field name="barcode" readonly="id"/>
                                    <field name="condition"/>
                                    <field name="acquisition_date" optional="show"/>
                                    <field name="borrower_name"/>
                                    <field name="due_date"/>
                                    <field name="state" widget="badge" decoration-success="state == 'available'"
                                           decoration-warning="state == 'on_loan'" decoration-danger="state == 'lost'"/>
                                    <button name="action_desk_checkout" type="object" icon="fa-arrow-circle-right text-primary"
                                            title="Prêter cet exemplaire" class="btn-link" invisible="state != 'available'"/>
                                    <button name="action_desk_return" type="object" icon="fa-check-circle text-success"
                                            title="Enregistrer le retour" class="btn-link" invisible="state != 'on_loan'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Résumé" name="description" icon="fa-align-left">
                            <field name="description" placeholder="Résumé, mots-clés, public visé…"/>
                        </page>
                        <page string="Historique" name="history" icon="fa-history">
                            <field name="loan_ids" readonly="1">
                                <list decoration-danger="state == 'overdue'" decoration-muted="state == 'returned'">
                                    <field name="reference"/>
                                    <field name="borrower_name"/>
                                    <field name="barcode_id"/>
                                    <field name="checkout_date"/>
                                    <field name="due_date"/>
                                    <field name="return_date"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="library_book_kanban_view" model="ir.ui.view">
        <field name="name">library.book.kanban</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <kanban class="o_eacta_kanban o_library_book_kanban" sample="1" quick_create="false">
                <field name="id"/>
                <field name="image"/>
                <field name="is_available"/>
                <field name="available_quantity"/>
                <field name="total_quantity"/>
                <templates>
                    <t t-name="card" class="p-0">
                        <div class="o_eacta_card o_library_book_card">
                            <div class="d-flex gap-3">
                                <div class="o_library_cover_tile">
                                    <t t-if="record.image.raw_value">
                                        <field name="image" widget="image" options="{'img_class': 'o_library_cover_img'}"/>
                                    </t>
                                    <i t-else="" class="fa fa-book" title="Livre"/>
                                </div>
                                <div class="flex-grow-1 min-w-0 d-flex flex-column gap-1">
                                    <field name="name" class="o_eacta_card_title text-truncate"/>
                                    <div class="o_eacta_card_meta text-truncate"><field name="author"/></div>
                                    <div class="d-flex flex-wrap gap-1 mt-1">
                                        <span class="o_eacta_tag" t-if="record.category_id.raw_value"><field name="category_id"/></span>
                                        <span class="o_eacta_tag" t-if="record.shelf_location.raw_value">
                                            <i class="fa fa-map-marker me-1" title="Emplacement"/><field name="shelf_location"/>
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="o_eacta_card_foot">
                                <span t-attf-class="o_eacta_badge #{record.is_available.raw_value ? 'o_eacta_badge_enrolled' : 'o_eacta_badge_draft'}">
                                    <t t-out="record.available_quantity.raw_value"/> / <t t-out="record.total_quantity.raw_value"/> disponible(s)
                                </span>
                                <button t-if="record.is_available.raw_value" name="action_borrow" type="object"
                                        class="btn btn-sm btn-primary">Prêter</button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="library_book_search_view" model="ir.ui.view">
        <field name="name">library.book.search</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <search string="Rechercher un livre">
                <field name="name" filter_domain="['|', '|', ('name', 'ilike', self), ('author', 'ilike', self), ('isbn', 'ilike', self)]"/>
                <field name="author"/>
                <field name="category_id"/>
                <field name="barcode_ids" string="Code-barres"/>
                <filter string="Disponibles" name="available" domain="[('is_available', '=', True)]"/>
                <filter string="Tous empruntés" name="unavailable" domain="[('is_available', '=', False)]"/>
                <separator/>
                <filter string="Archivés" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Regrouper par">
                    <filter string="Catégorie" name="group_category" context="{'group_by': 'category_id'}"/>
                    <filter string="Auteur" name="group_author" context="{'group_by': 'author'}"/>
                    <filter string="Langue" name="group_language" context="{'group_by': 'language'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_library_book" model="ir.actions.act_window">
        <field name="name">Catalogue</field>
        <field name="res_model">library.book</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="library_book_search_view"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Ajoutez votre premier livre</p>
            <p>Indiquez le nombre d'exemplaires : les codes-barres sont générés automatiquement.</p>
        </field>
    </record>

    <!-- ============================ EXEMPLAIRES ============================ -->
    <record id="view_library_copy_list" model="ir.ui.view">
        <field name="name">library.book.barcode.list</field>
        <field name="model">library.book.barcode</field>
        <field name="arch" type="xml">
            <list string="Exemplaires" decoration-muted="state == 'lost'" decoration-warning="state == 'on_loan'">
                <field name="barcode"/>
                <field name="book_id"/>
                <field name="condition"/>
                <field name="borrower_name"/>
                <field name="due_date"/>
                <field name="state" widget="badge" decoration-success="state == 'available'"
                       decoration-warning="state == 'on_loan'" decoration-danger="state == 'lost'"/>
                <button name="action_desk_checkout" type="object" icon="fa-arrow-circle-right text-primary"
                        title="Prêter cet exemplaire" class="btn-link" invisible="state != 'available'"/>
                <button name="action_desk_return" type="object" icon="fa-check-circle text-success"
                        title="Enregistrer le retour" class="btn-link" invisible="state != 'on_loan'"/>
            </list>
        </field>
    </record>

    <record id="view_library_copy_form" model="ir.ui.view">
        <field name="name">library.book.barcode.form</field>
        <field name="model">library.book.barcode</field>
        <field name="arch" type="xml">
            <form string="Exemplaire">
                <header>
                    <button name="action_desk_checkout" string="Prêter cet exemplaire" type="object"
                            class="btn-primary" invisible="state != 'available'"/>
                    <button name="action_desk_return" string="Enregistrer le retour" type="object"
                            class="btn-success" invisible="state != 'on_loan'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_loans" type="object" class="oe_stat_button" icon="fa-history"
                                string="Historique"/>
                    </div>
                    <div class="oe_title">
                        <label for="barcode"/>
                        <h1><field name="barcode"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="book_id"/>
                            <field name="condition"/>
                            <field name="acquisition_date"/>
                            <field name="manual_barcode"/>
                        </group>
                        <group invisible="state != 'on_loan'">
                            <field name="current_loan_id"/>
                            <field name="borrower_name"/>
                            <field name="due_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_library_copy_search" model="ir.ui.view">
        <field name="name">library.book.barcode.search</field>
        <field name="model">library.book.barcode</field>
        <field name="arch" type="xml">
            <search>
                <field name="barcode"/>
                <field name="book_id"/>
                <filter string="Disponibles" name="available" domain="[('state', '=', 'available')]"/>
                <filter string="Empruntés" name="on_loan" domain="[('state', '=', 'on_loan')]"/>
                <filter string="Perdus" name="lost" domain="[('state', '=', 'lost')]"/>
                <filter string="Abîmés" name="damaged" domain="[('condition', '=', 'damaged')]"/>
                <group expand="0" string="Regrouper par">
                    <filter string="Livre" name="group_book" context="{'group_by': 'book_id'}"/>
                    <filter string="Statut" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_library_copy" model="ir.actions.act_window">
        <field name="name">Exemplaires</field>
        <field name="res_model">library.book.barcode</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_library_copy_search"/>
    </record>

    <!-- ============================ CATÉGORIES ============================ -->
    <record id="library_book_category_tree_view" model="ir.ui.view">
        <field name="name">library.book.category.list</field>
        <field name="model">library.book.category</field>
        <field name="arch" type="xml">
            <list string="Catégories" editable="bottom">
                <field name="name"/>
                <field name="book_count"/>
                <field name="copy_count"/>
                <field name="available_book_count"/>
                <field name="color" widget="color_picker" optional="show"/>
                <button name="action_view_books" type="object" string="Livres" icon="fa-book" class="btn-link"/>
            </list>
        </field>
    </record>

    <record id="action_library_book_category" model="ir.actions.act_window">
        <field name="name">Catégories</field>
        <field name="res_model">library.book.category</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
