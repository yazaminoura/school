<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="library_borrower_tree_view" model="ir.ui.view">
        <field name="name">library.borrower.list</field>
        <field name="model">library.borrower</field>
        <field name="arch" type="xml">
            <list string="Lecteurs" decoration-danger="overdue_loans_count">
                <field name="name"/>
                <field name="borrower_type"/>
                <field name="class_id" optional="show"/>
                <field name="email" optional="hide"/>
                <field name="active_loans_count"/>
                <field name="overdue_loans_count"/>
                <field name="total_loans_count" optional="show"/>
                <field name="fine_due" optional="show" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="library_borrower_kanban_view" model="ir.ui.view">
        <field name="name">library.borrower.kanban</field>
        <field name="model">library.borrower</field>
        <field name="arch" type="xml">
            <kanban class="o_eacta_kanban" sample="1" quick_create="false">
                <field name="id"/>
                <field name="image_128"/>
                <field name="active_loans_count"/>
                <field name="overdue_loans_count"/>
                <field name="total_loans_count"/>
                <templates>
                    <t t-name="card" class="p-0">
                        <div class="o_eacta_card">
                            <div class="o_eacta_card_head">
                                <t t-if="record.image_128.raw_value">
                                    <field name="image_128" widget="image" class="o_eacta_avatar"
                                           options="{'img_class': 'o_eacta_avatar_img'}"/>
                                </t>
                                <div t-else="" class="o_eacta_avatar o_eacta_avatar_initials">
                                    <t t-out="(record.name.value or '?').charAt(0).toUpperCase()"/>
                                </div>
                                <div class="flex-grow-1 min-w-0">
                                    <field name="name" class="o_eacta_card_title d-block text-truncate"/>
                                    <div class="o_eacta_card_meta"><field name="borrower_type"/> <t t-if="record.class_id.raw_value">· <field name="class_id"/></t></div>
                                </div>
                            </div>
                            <div class="o_eacta_card_foot">
                                <span class="text-muted small">
                                    <i class="fa fa-book me-1" title="Emprunts"/><t t-out="record.active_loans_count.raw_value"/> en cours ·
                                    <t t-out="record.total_loans_count.raw_value"/> au total
                                </span>
                                <span t-if="record.overdue_loans_count.raw_value" class="o_eacta_score o_eacta_score_low">
                                    <t t-out="record.overdue_loans_count.raw_value"/> en retard
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_library_borrower_form" model="ir.ui.view">
        <field name="name">library.borrower.form</field>
        <field name="model">library.borrower</field>
        <field name="arch" type="xml">
            <form string="Lecteur">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="open_loans" type="object" class="oe_stat_button" icon="fa-book">
                            <field name="active_loans_count" widget="statinfo" string="En cours"/>
                        </button>
                        <button name="open_loans" type="object" class="oe_stat_button" icon="fa-history">
                            <field name="total_loans_count" widget="statinfo" string="Au total"/>
                        </button>
                    </div>
                    <field name="image_128" widget="image" class="oe_avatar" readonly="1"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="borrower_type"/>
                            <field name="student_id" invisible="borrower_type != 'student'"/>
                            <field name="class_id" invisible="borrower_type != 'student'"/>
                            <field name="teacher_id" invisible="borrower_type != 'teacher'"/>
                        </group>
                        <group>
                            <field name="email" widget="email"/>
                            <field name="phone" widget="phone"/>
                            <field name="overdue_loans_count"/>
                            <field name="fine_due"/>
                        </group>
                    </group>
                    <field name="loan_ids" readonly="1">
                        <list decoration-danger="state == 'overdue'" decoration-muted="state == 'returned'">
                            <field name="reference"/>
                            <field name="book_id"/>
                            <field name="checkout_date"/>
                            <field name="due_date"/>
                            <field name="return_date"/>
                            <field name="fine_amount"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="library_borrower_search_view" model="ir.ui.view">
        <field name="name">library.borrower.search</field>
        <field name="model">library.borrower</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="class_id"/>
                <filter string="Avec emprunts en cours" name="active_loans" domain="[('active_loans_count', '>', 0)]"/>
                <filter string="En retard" name="overdue" domain="[('overdue_loans_count', '>', 0)]"/>
                <filter string="Amendes dues" name="fines" domain="[('fine_due', '>', 0)]"/>
                <separator/>
                <filter string="Élèves" name="students" domain="[('borrower_type', '=', 'student')]"/>
                <filter string="Enseignants" name="teachers" domain="[('borrower_type', '=', 'teacher')]"/>
                <group expand="0" string="Regrouper par">
                    <filter string="Type" name="group_type" context="{'group_by': 'borrower_type'}"/>
                    <filter string="Classe" name="group_class" context="{'group_by': 'class_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_library_borrower" model="ir.actions.act_window">
        <field name="name">Lecteurs</field>
        <field name="res_model">library.borrower</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="library_borrower_search_view"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun lecteur</p>
            <p>Les fiches lecteur sont créées automatiquement au premier emprunt.</p>
        </field>
    </record>

    <!-- Réglages -->
    <record id="res_config_settings_view_form_library" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.library</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Bibliothèque" string="Bibliothèque" name="eacta_bibliotheque"
                     groups="eacta_bibliotheque.group_eacta_library_manager">
                    <block title="Règles de prêt" name="library_rules">
                        <setting string="Amendes de retard" help="Appliquer une pénalité financière pour chaque jour de retard lors du retour des livres">
                            <field name="library_enable_overdue_fines"/>
                            <div class="content-group" invisible="not library_enable_overdue_fines">
                                <div class="row mt-2">
                                    <label for="library_fine_per_day" class="col-lg-5 o_light_label"/>
                                    <field name="library_fine_per_day"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Relances automatiques" help="Notification automatique par email en cas d'emprunt en retard">
                            <field name="library_send_overdue_reminder_email"/>
                            <div class="content-group" invisible="not library_send_overdue_reminder_email">
                                <div class="row mt-2">
                                    <label for="library_overdue_reminder_interval_days" class="col-lg-5 o_light_label"/>
                                    <field name="library_overdue_reminder_interval_days"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Prolongations" help="Nombre maximum de prolongations par emprunt">
                            <field name="library_max_renewals"/>
                        </setting>
                        <setting string="Limite par élève" help="Nombre d'emprunts simultanés autorisés">
                            <field name="library_max_loans_student"/>
                        </setting>
                        <setting string="Limite par enseignant" help="Nombre d'emprunts simultanés autorisés">
                            <field name="library_max_loans_teacher"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_library_settings" model="ir.actions.act_window">
        <field name="name">Réglages</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'eacta_bibliotheque', 'bin_size': False}</field>
    </record>

</odoo>
