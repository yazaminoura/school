<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="group_eacta_library" model="ir.module.category">
        <field name="name">NR School - Bibliothèque</field>
        <field name="description">Droits d'accès à la bibliothèque</field>
        <field name="sequence">30</field>
    </record>

    <record id="group_eacta_library_user" model="res.groups">
        <field name="name">Bibliothécaire</field>
        <field name="category_id" ref="group_eacta_library"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_eacta_library_manager" model="res.groups">
        <field name="name">Responsable bibliothèque</field>
        <field name="category_id" ref="group_eacta_library"/>
        <field name="implied_ids" eval="[(4, ref('group_eacta_library_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Les responsables de l'école gèrent aussi la bibliothèque -->
    <record id="eacta_school.group_eacta_school_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_eacta_library_user'))]"/>
    </record>

    <!-- ============================================================ -->
    <!-- RÈGLES DE SÉCURITÉ (RECORD RULES)                             -->
    <!-- ============================================================ -->

    <!-- Responsables et bibliothécaires voient tous les emprunts -->
    <record id="rule_library_loan_manager" model="ir.rule">
        <field name="name">Bibliothèque (Gestionnaire) : tous les emprunts</field>
        <field name="model_id" ref="model_library_loan"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_eacta_library_user')), (4, ref('group_eacta_library_manager'))]"/>
    </record>

    <!-- Enseignants : voient leurs propres emprunts -->
    <record id="rule_library_loan_teacher" model="ir.rule">
        <field name="name">Bibliothèque (Enseignant) : ses propres emprunts</field>
        <field name="model_id" ref="model_library_loan"/>
        <field name="domain_force">[('teacher_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="groups" eval="[(4, ref('eacta_school.group_eacta_school_teacher'))]"/>
    </record>

    <!-- Portail (Parents & Élèves) : voient uniquement leurs emprunts -->
    <record id="rule_library_loan_portal" model="ir.rule">
        <field name="name">Bibliothèque (Portail) : emprunts de ses enfants ou ses propres emprunts</field>
        <field name="model_id" ref="model_library_loan"/>
        <field name="domain_force">['|', '|', ('student_id.parent_ids', 'in', [user.partner_id.id]), ('student_id.user_id', '=', user.id), ('student_id.partner_id', '=', user.partner_id.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <!-- Livres du catalogue : visibles en lecture par tous -->
    <record id="rule_library_book_all" model="ir.rule">
        <field name="name">Bibliothèque : catalogue public</field>
        <field name="model_id" ref="model_library_book"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="groups" eval="[(4, ref('base.group_portal')), (4, ref('eacta_school.group_eacta_school_teacher'))]"/>
    </record>

</odoo>
