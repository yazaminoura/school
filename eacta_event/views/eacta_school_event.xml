<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_eacta_school_event_form" model="ir.ui.view">
        <field name="name">eacta.school.event.form</field>
        <field name="model">eacta.school.event</field>
        <field name="arch" type="xml">
            <form string="Événement Scolaire">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_participants" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="participant_count" widget="statinfo" string="Participants"/>
                        </button>
                    </div>
                    <field name="image" widget="image" class="oe_avatar eacta_avatar_form" options="{'zoom': true, 'preview_image': 'image'}"/>
                    <div class="oe_title">
                        <label for="name" string="Nom de l'Événement" class="oe_edit_only"/>
                        <h1 class="d-flex align-items-center gap-2">
                            <field name="name" placeholder="ex: Cérémonie de Remise des Diplômes 2026"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Planning &amp; Organisation">
                            <field name="date"/>
                            <field name="organizer_id" widget="many2one_avatar_user"/>
                        </group>
                        <group string="Inscriptions">
                            <field name="participant_ids" widget="many2many_tags" placeholder="Sélectionner les élèves participants..."/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description &amp; Programme" icon="fa-file-text-o">
                            <field name="description" placeholder="Détails du programme, objectifs, consignes pour les élèves et intervenants..."/>
                        </page>
                        <page string="Liste des Participants" icon="fa-users">
                            <field name="participant_ids">
                                <list string="Participants">
                                    <field name="photo" widget="image" class="oe_avatar" style="width: 35px; height: 35px; border-radius: 50%;" optional="show"/>
                                    <field name="enrollment_number" string="Matricule"/>
                                    <field name="name" string="Nom complet"/>
                                    <field name="class_ids" widget="many2many_tags" string="Classe(s)"/>
                                    <field name="gender" string="Genre" optional="show"/>
                                    <field name="status" widget="badge" decoration-success="status == 'enrolled'" decoration-info="status == 'graduated'" optional="show"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_eacta_school_event_tree" model="ir.ui.view">
        <field name="name">eacta.school.event.list</field>
        <field name="model">eacta.school.event</field>
        <field name="arch" type="xml">
            <list string="Événements Scolaires" decoration-info="date and date &gt;= current_date">
                <field name="name" string="Événement" class="fw-bold"/>
                <field name="date" widget="date" string="Date"/>
                <field name="organizer_id" widget="many2one_avatar_user" string="Organisateur"/>
                <field name="participant_count" string="Participants" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_eacta_school_event_kanban" model="ir.ui.view">
        <field name="name">eacta.school.event.kanban</field>
        <field name="model">eacta.school.event</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id"/>
                <field name="name"/>
                <field name="date"/>
                <field name="organizer_id"/>
                <field name="image"/>
                <field name="participant_count"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click eacta_card_custom eacta_event_card p-0 overflow-hidden">
                            <div class="eacta_event_banner position-relative" style="height: 120px; background: linear-gradient(135deg, #4F46E5 0%, #06B6D4 100%);">
                                <img t-if="record.image.raw_value"
                                     t-att-src="kanban_image('eacta.school.event', 'image', record.id.raw_value)"
                                     style="width: 100%; height: 100%; object-fit: cover;"
                                     alt="Event Banner"/>
                                <div t-else="" class="h-100 d-flex align-items-center justify-content-center text-white">
                                    <i class="fa fa-calendar-check-o fa-3x opacity-50"/>
                                </div>
                                <div class="position-absolute top-0 end-0 m-2">
                                    <span class="badge bg-white text-dark shadow-sm px-2 py-1 rounded-pill small">
                                        <i class="fa fa-calendar me-1 text-primary"/>
                                        <field name="date"/>
                                    </span>
                                </div>
                            </div>
                            <div class="p-3">
                                <h5 class="fw-bold text-dark mb-1 text-truncate">
                                    <field name="name"/>
                                </h5>
                                <div class="d-flex align-items-center justify-content-between mt-3 pt-2 border-top">
                                    <div class="d-flex align-items-center gap-2">
                                        <field name="organizer_id" widget="many2one_avatar_user"/>
                                        <small class="text-muted text-truncate" style="max-width: 110px;">
                                            <field name="organizer_id"/>
                                        </small>
                                    </div>
                                    <span class="badge bg-light text-primary border rounded-pill px-2 py-1">
                                        <i class="fa fa-users me-1"/>
                                        <field name="participant_count"/> élèves
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action -->
    <record id="action_eacta_school_event" model="ir.actions.act_window">
        <field name="name">Événements Scolaires</field>
        <field name="res_model">eacta.school.event</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre premier événement scolaire !
            </p>
            <p>
                Organisez les sorties scolaires, journées portes ouvertes, compétitions et remises de diplômes.
            </p>
        </field>
    </record>

    <!-- Menu Items -->
    <record id="menu_eacta_school_root" model="ir.ui.menu">
        <field name="name">E-ACTA Event</field>
        <field name="sequence">10</field>
    </record>

    <menuitem id="menu_eacta_event"
              name="Événements Scolaires"
              parent="menu_eacta_school_root"
              action="action_eacta_school_event"
              sequence="60"/>
</odoo>

