<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================== FORM ============================== -->
    <record id="view_eacta_school_event_form" model="ir.ui.view">
        <field name="name">eacta.school.event.form</field>
        <field name="model">eacta.school.event</field>
        <field name="arch" type="xml">
            <form string="Événement">
                <header>
                    <button name="action_confirm" string="Confirmer" type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_start" string="Démarrer l'événement" type="object" class="btn-primary"
                            invisible="state != 'confirmed'"/>
                    <button name="action_register_classes" string="Inscrire les classes" type="object"
                            class="btn-primary" icon="fa-users" invisible="state not in ('draft', 'confirmed') or not class_ids"/>
                    <button name="action_print_authorizations" string="Autorisations parentales" type="object"
                            icon="fa-print" invisible="not requires_authorization or not participant_count or state == 'cancel'"/>
                    <button name="action_print_attendance" string="Feuille de présence" type="object" icon="fa-print"
                            invisible="not participant_count"/>
                    <button name="action_generate_fees" string="Facturer les élèves" type="object" icon="fa-money"
                            invisible="not fee_amount or not participant_count or state == 'cancel'"
                            groups="eacta_school.group_eacta_school_manager"/>
                    <button name="action_mark_all_attended" string="Pointer tous présents" type="object" icon="fa-check-circle"
                            invisible="state not in ('confirmed', 'in_progress') or not participant_count"
                            confirm="Marquer tous les élèves inscrits comme présents ?"/>
                    <button name="action_sync_school_attendance" string="Synchroniser l'assiduité" type="object"
                            icon="fa-calendar-check-o" invisible="state not in ('in_progress', 'done') or not attended_count"/>
                    <button name="action_send_parent_reminders" string="Relancer les parents" type="object"
                            icon="fa-bell-o" class="btn-secondary" invisible="state in ('draft', 'cancel') or not participant_count"
                            help="Envoie un rappel automatique aux familles ayant des autorisations ou paiements en attente"/>
                    <button name="action_done" string="Clôturer" type="object" invisible="state not in ('confirmed', 'in_progress')"
                            help="Les inscrits non pointés passent en « Absent »"/>
                    <button name="action_cancel" string="Annuler" type="object" invisible="state in ('done', 'cancel')"
                            confirm="Annuler cet événement ?"/>
                    <button name="action_reset_draft" string="Remettre en brouillon" type="object"
                            invisible="state not in ('cancel', 'done')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_registrations" type="object" class="oe_stat_button" icon="fa-users">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="participant_count"/><span invisible="not capacity"> / <field name="capacity" readonly="1"/></span>
                                </span>
                                <span class="o_stat_text">Inscrits</span>
                            </div>
                        </button>
                        <button name="action_view_registrations" type="object" class="oe_stat_button" icon="fa-check-square-o"
                                invisible="state != 'done'">
                            <field name="attended_count" widget="statinfo" string="Présents"/>
                        </button>
                        <button name="action_view_expenses" type="object" class="oe_stat_button" icon="fa-calculator">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="total_expenses"/></span>
                                <span class="o_stat_text">Dépenses</span>
                            </div>
                        </button>
                        <button name="action_view_medical_sheet" type="object" class="oe_stat_button" icon="fa-medkit"
                                invisible="not medical_alert_count">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value text-danger"><field name="medical_alert_count"/></span>
                                <span class="o_stat_text">Alertes PAI</span>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Annulé" bg_color="text-bg-danger" invisible="state != 'cancel'"/>
                    <widget name="web_ribbon" title="En cours" bg_color="text-bg-warning" invisible="state != 'in_progress'"/>
                    <widget name="web_ribbon" title="Terminé" bg_color="text-bg-success" invisible="state != 'done'"/>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <field name="event_type" class="o_eacta_chip"/>
                        <h1><field name="name" placeholder="ex : Sortie au musée"/></h1>
                    </div>

                    <div class="o_eacta_kpis" invisible="not participant_count">
                        <div class="o_eacta_kpi">
                            <span class="o_eacta_kpi_label">Inscrits</span>
                            <span class="o_eacta_kpi_value"><field name="participant_count" class="oe_inline"/>
                                <small invisible="not capacity"> / <field name="capacity" class="oe_inline" readonly="1"/></small></span>
                            <field name="fill_rate" widget="progressbar" class="o_eacta_kpi_bar" invisible="not capacity"/>
                        </div>
                        <div class="o_eacta_kpi" invisible="not requires_authorization">
                            <span class="o_eacta_kpi_label">Autorisations</span>
                            <span class="o_eacta_kpi_value"><field name="authorized_count" class="oe_inline"/><small> / <field name="participant_count" class="oe_inline"/></small></span>
                        </div>
                        <div class="o_eacta_kpi" invisible="not fee_amount">
                            <span class="o_eacta_kpi_label">Encaissé</span>
                            <span class="o_eacta_kpi_value"><field name="amount_collected" class="oe_inline"/></span>
                            <small class="text-muted">sur <field name="amount_expected" class="oe_inline"/></small>
                        </div>
                        <div class="o_eacta_kpi" invisible="not total_expenses and not fee_amount">
                            <span class="o_eacta_kpi_label">Dépenses</span>
                            <span class="o_eacta_kpi_value"><field name="total_expenses" class="oe_inline"/></span>
                        </div>
                        <div class="o_eacta_kpi" invisible="not total_expenses and not amount_collected">
                            <span class="o_eacta_kpi_label">Solde net</span>
                            <span class="o_eacta_kpi_value"><field name="net_margin" class="oe_inline"/></span>
                        </div>
                    </div>

                    <group>
                        <group string="Quand &amp; où">
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="location" placeholder="ex : Musée Mohammed VI, Rabat"/>
                            <field name="registration_deadline"/>
                        </group>
                        <group string="Organisation">
                            <field name="organizer_id" widget="many2one_avatar_user"/>
                            <field name="supervisor_ids" widget="many2many_avatar_user"/>
                            <field name="class_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="capacity"/>
                            <field name="requires_authorization"/>
                            <field name="fee_amount"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Inscriptions" name="registrations" icon="fa-users">
                            <field name="registration_ids" context="{'default_event_id': id}">
                                <list editable="bottom" decoration-muted="state == 'cancelled'"
                                      decoration-success="state == 'attended'" decoration-danger="state == 'absent'">
                                    <field name="student_id" options="{'no_create': True}"/>
                                    <field name="class_id"/>
                                    <field name="parent_id" optional="show"/>
                                    <field name="authorized" widget="boolean_toggle"
                                           column_invisible="not parent.requires_authorization"/>
                                    <field name="authorization_method" widget="badge" optional="show"
                                           column_invisible="not parent.requires_authorization"
                                           decoration-success="authorization_method == 'portal'"
                                           decoration-info="authorization_method == 'paper'"/>
                                    <field name="authorized_by_parent_id" optional="hide"
                                           column_invisible="not parent.requires_authorization"/>
                                    <field name="paid" widget="boolean_toggle" column_invisible="not parent.fee_amount"/>
                                    <field name="fee_state" widget="badge" optional="show"
                                           decoration-success="fee_state == 'paid'" decoration-warning="fee_state == 'unpaid'"
                                           column_invisible="not parent.fee_amount"/>
                                    <field name="fee_id" optional="hide" column_invisible="not parent.fee_amount"/>
                                    <field name="state" widget="badge" decoration-info="state == 'registered'"
                                           decoration-success="state == 'attended'" decoration-danger="state == 'absent'"/>
                                    <button name="action_mark_attended" type="object" icon="fa-check" title="Présent"
                                            class="btn-link text-success" invisible="state == 'attended'"/>
                                    <button name="action_mark_absent" type="object" icon="fa-times" title="Absent"
                                            class="btn-link text-danger" invisible="state == 'absent'"/>
                                    <field name="note" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Programme" name="program" icon="fa-list-ol">
                            <field name="description" placeholder="Résumé affiché sur les autorisations parentales…"/>
                            <field name="program" placeholder="Déroulé de la journée, matériel à prévoir…"/>
                        </page>
                        <page string="Logistique &amp; Transport" name="logistics" icon="fa-bus">
                            <group>
                                <group string="Déplacement &amp; Transport">
                                    <field name="transport_type"/>
                                    <field name="transport_company" invisible="transport_type in ('none', 'walking')"/>
                                    <field name="driver_contact" invisible="transport_type in ('none', 'walking')"/>
                                    <field name="vehicle_plate" invisible="transport_type in ('none', 'walking')"/>
                                    <field name="departure_meeting_point" placeholder="ex : Cour d'honneur à 08h15"/>
                                    <field name="return_estimated_time" placeholder="ex : 17h30"/>
                                </group>
                                <group string="Sécurité &amp; Encadrement">
                                    <field name="supervisor_ratio" widget="float"/>
                                    <field name="emergency_contact" placeholder="ex : Dr. Benjelloun / M. Directeur"/>
                                    <field name="emergency_phone"/>
                                    <field name="first_aid_kit" widget="boolean_toggle"/>
                                    <field name="safety_briefing_done" widget="boolean_toggle"/>
                                </group>
                            </group>
                        </page>
                        <page string="Budget &amp; Dépenses" name="expenses" icon="fa-money">
                            <group>
                                <group string="Récapitulatif Financier">
                                    <field name="amount_expected"/>
                                    <field name="amount_collected"/>
                                    <field name="total_expenses"/>
                                    <field name="net_margin" decoration-danger="net_margin &lt; 0" decoration-success="net_margin &gt;= 0"/>
                                    <field name="financial_result_status" widget="badge"
                                           decoration-success="financial_result_status == 'profit'"
                                           decoration-info="financial_result_status == 'balanced'"
                                           decoration-danger="financial_result_status == 'deficit'"/>
                                </group>
                            </group>
                            <separator string="Lignes de Dépenses"/>
                            <field name="expense_ids" context="{'default_event_id': id}">
                                <list editable="bottom">
                                    <field name="name" placeholder="ex : Location 2 autocars"/>
                                    <field name="expense_type"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="vendor"/>
                                    <field name="payment_date"/>
                                    <field name="state" widget="badge" decoration-success="state == 'paid'" decoration-info="state == 'planned'"/>
                                    <field name="notes" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Santé &amp; PAI" name="health_alerts" icon="fa-heartbeat" invisible="not medical_alert_count">
                            <div class="alert alert-warning d-flex align-items-center gap-3" role="alert">
                                <i class="fa fa-exclamation-triangle fa-2x text-warning"></i>
                                <div>
                                    <strong class="d-block">Attention médicale requise :</strong>
                                    <span><field name="medical_alert_count" class="oe_inline fw-bold"/> élève(s) inscrit(s) présentent des allergies déclarées ou un protocole médical PAI.</span>
                                </div>
                            </div>
                            <field name="medical_alert_summary" readonly="1" widget="text" class="p-3 bg-light rounded"/>
                        </page>
                        <page string="Bilan de l'activité" name="debrief" icon="fa-star" invisible="state in ('draft', 'confirmed')">
                            <group>
                                <group string="Évaluation globale">
                                    <field name="rating" widget="priority"/>
                                    <field name="pedagogical_objectives_met" widget="boolean_toggle"/>
                                </group>
                                <group string="Incidents éventuels">
                                    <field name="incident_notes" placeholder="Rien à signaler ou détail de tout incident survenu…"/>
                                </group>
                            </group>
                            <separator string="Compte-rendu pédagogique"/>
                            <field name="debrief_notes" placeholder="Points forts, déroulement, réactions des élèves, axes d'amélioration pour la prochaine édition…"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================== LIST ============================== -->
    <record id="view_eacta_school_event_tree" model="ir.ui.view">
        <field name="name">eacta.school.event.list</field>
        <field name="model">eacta.school.event</field>
        <field name="arch" type="xml">
            <list string="Événements" sample="1" decoration-muted="state == 'cancel'">
                <field name="date_start"/>
                <field name="name"/>
                <field name="event_type"/>
                <field name="location" optional="show"/>
                <field name="class_ids" widget="many2many_tags" optional="show"/>
                <field name="organizer_id" widget="many2one_avatar_user" optional="show"/>
                <field name="participant_count" string="Inscrits"/>
                <field name="capacity" optional="hide"/>
                <field name="amount_collected" optional="hide" sum="Total"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'"
                       decoration-success="state == 'confirmed'" decoration-muted="state in ('done', 'cancel')"/>
            </list>
        </field>
    </record>

    <!-- ============================= KANBAN ============================= -->
    <record id="view_eacta_school_event_kanban" model="ir.ui.view">
        <field name="name">eacta.school.event.kanban</field>
        <field name="model">eacta.school.event</field>
        <field name="arch" type="xml">
            <kanban class="o_eacta_kanban o_event_kanban" default_group_by="state" sample="1" quick_create="false"
                    group_create="false" group_delete="false" group_edit="false">
                <field name="id"/>
                <field name="image"/>
                <field name="date_start"/>
                <field name="capacity"/>
                <field name="participant_count"/>
                <field name="fill_rate"/>
                <field name="state"/>
                <progressbar field="state" colors='{"draft": "info", "confirmed": "primary", "in_progress": "warning", "done": "success", "cancel": "danger"}'/>
                <templates>
                    <t t-name="card" class="p-0">
                        <div class="o_event_card">
                            <div class="o_event_banner">
                                <t t-if="record.image.raw_value">
                                    <field name="image" widget="image" options="{'img_class': 'o_event_banner_img'}"/>
                                </t>
                                <i t-else="" class="fa fa-calendar-check-o" title="Événement"/>
                                <div class="o_event_date" t-if="record.date_start.raw_value">
                                    <strong t-out="luxon.DateTime.fromISO(record.date_start.raw_value).toFormat('dd')"/>
                                    <small t-out="luxon.DateTime.fromISO(record.date_start.raw_value).toFormat('LLL')"/>
                                </div>
                            </div>
                            <div class="o_eacta_card">
                                <div>
                                    <field name="name" class="o_eacta_card_title d-block text-truncate"/>
                                    <div class="o_eacta_card_meta text-truncate">
                                        <field name="event_type"/>
                                        <t t-if="record.location.raw_value"> · <field name="location"/></t>
                                    </div>
                                </div>
                                <div class="o_eacta_meter" t-if="record.capacity.raw_value">
                                    <div class="d-flex justify-content-between small">
                                        <span class="text-muted">Places</span>
                                        <strong><t t-out="record.participant_count.raw_value"/> / <t t-out="record.capacity.raw_value"/></strong>
                                    </div>
                                    <div class="o_eacta_meter_track">
                                        <div t-attf-class="o_eacta_meter_fill #{record.fill_rate.raw_value &gt;= 100 ? 'o_eacta_meter_full' : ''}"
                                             t-attf-style="width: #{Math.min(record.fill_rate.raw_value, 100)}%"/>
                                    </div>
                                </div>
                                <div class="o_eacta_card_foot">
                                    <field name="organizer_id" widget="many2one_avatar_user"/>
                                    <span class="text-muted small">
                                        <i class="fa fa-users me-1" title="Inscrits"/><t t-out="record.participant_count.raw_value"/> inscrit(s)
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_eacta_school_event_calendar" model="ir.ui.view">
        <field name="name">eacta.school.event.calendar</field>
        <field name="model">eacta.school.event</field>
        <field name="arch" type="xml">
            <calendar string="Calendrier des événements" date_start="date_start" date_stop="date_end"
                      color="event_type" mode="month" event_open_popup="1" all_day="all_day">
                <field name="name"/>
                <field name="event_type" filters="1"/>
                <field name="location"/>
                <field name="participant_count"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="view_eacta_school_event_pivot" model="ir.ui.view">
        <field name="name">eacta.school.event.pivot</field>
        <field name="model">eacta.school.event</field>
        <field name="arch" type="xml">
            <pivot string="Analyse des événements" sample="1">
                <field name="event_type" type="row"/>
                <field name="date_start" interval="month" type="col"/>
                <field name="participant_count" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_eacta_school_event_graph" model="ir.ui.view">
        <field name="name">eacta.school.event.graph</field>
        <field name="model">eacta.school.event</field>
        <field name="arch" type="xml">
            <graph string="Participants par type d'événement" type="bar" sample="1">
                <field name="event_type"/>
                <field name="participant_count" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_eacta_school_event_search" model="ir.ui.view">
        <field name="name">eacta.school.event.search</field>
        <field name="model">eacta.school.event</field>
        <field name="arch" type="xml">
            <search string="Rechercher un événement">
                <field name="name"/>
                <field name="location"/>
                <field name="class_ids"/>
                <field name="participant_ids" string="Élève"/>
                <filter string="Mes événements" name="mine" domain="['|', ('organizer_id', '=', uid), ('supervisor_ids', 'in', uid)]"/>
                <separator/>
                <filter string="À venir" name="upcoming" domain="[('date', '>=', context_today().strftime('%Y-%m-%d')), ('state', '!=', 'cancel')]"/>
                <filter string="Passés" name="past" domain="[('date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="Confirmés" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Date" name="filter_date" date="date"/>
                <group expand="0" string="Regrouper par">
                    <filter string="Type" name="group_type" context="{'group_by': 'event_type'}"/>
                    <filter string="État" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Mois" name="group_month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_eacta_school_event" model="ir.actions.act_window">
        <field name="name">Événements</field>
        <field name="res_model">eacta.school.event</field>
        <field name="view_mode">kanban,calendar,list,pivot,graph,form</field>
        <field name="search_view_id" ref="view_eacta_school_event_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Planifiez votre premier événement</p>
            <p>Sorties, voyages, cérémonies, réunions parents… Inscrivez des classes entières en un clic,
               suivez les autorisations parentales, les paiements et les présences.</p>
        </field>
    </record>

    <record id="action_eacta_school_event_calendar" model="ir.actions.act_window">
        <field name="name">Calendrier des événements</field>
        <field name="res_model">eacta.school.event</field>
        <field name="view_mode">calendar,kanban,list,form</field>
        <field name="search_view_id" ref="view_eacta_school_event_search"/>
        <field name="context">{'search_default_upcoming': 1}</field>
    </record>

    <record id="action_eacta_school_event_analysis" model="ir.actions.act_window">
        <field name="name">Analyse des événements</field>
        <field name="res_model">eacta.school.event</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="search_view_id" ref="view_eacta_school_event_search"/>
        <field name="context">{'search_default_group_type': 1}</field>
    </record>

    <!-- ========================== INSCRIPTIONS ========================== -->
    <record id="view_event_registration_list" model="ir.ui.view">
        <field name="name">eacta.school.event.registration.list</field>
        <field name="model">eacta.school.event.registration</field>
        <field name="arch" type="xml">
            <list string="Inscriptions" editable="bottom" decoration-muted="state == 'cancelled'"
                  decoration-success="state == 'attended'" decoration-danger="state == 'absent'">
                <field name="event_id"/>
                <field name="event_date" optional="show"/>
                <field name="student_id"/>
                <field name="class_id"/>
                <field name="parent_id" optional="hide"/>
                <field name="authorized" widget="boolean_toggle"/>
                <field name="paid" widget="boolean_toggle"/>
                <field name="fee_state" widget="badge" optional="show"
                       decoration-success="fee_state == 'paid'" decoration-warning="fee_state == 'unpaid'"/>
                <field name="amount" optional="hide"/>
                <field name="fee_id" optional="hide"/>
                <field name="state" widget="badge" decoration-info="state == 'registered'"
                       decoration-success="state == 'attended'" decoration-danger="state == 'absent'"/>
                <button name="action_mark_attended" type="object" icon="fa-check text-success" title="Pointer présent"
                        class="btn-link" invisible="state == 'attended'"/>
                <button name="action_mark_absent" type="object" icon="fa-times text-danger" title="Pointer absent"
                        class="btn-link" invisible="state == 'absent'"/>
                <field name="note" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_event_registration_form" model="ir.ui.view">
        <field name="name">eacta.school.event.registration.form</field>
        <field name="model">eacta.school.event.registration</field>
        <field name="arch" type="xml">
            <form string="Inscription">
                <header>
                    <button name="action_mark_attended" string="Présent" type="object" class="btn-primary"
                            invisible="state == 'attended'"/>
                    <button name="action_mark_absent" string="Absent" type="object" invisible="state == 'absent'"/>
                    <button name="action_cancel" string="Annuler l'inscription" type="object"
                            invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="event_id"/>
                            <field name="student_id"/>
                            <field name="class_id"/>
                            <field name="parent_id"/>
                        </group>
                        <group>
                            <field name="authorized"/>
                            <field name="authorization_date" invisible="not authorized"/>
                            <field name="paid"/>
                            <field name="fee_id" readonly="1" invisible="not fee_id"/>
                            <field name="fee_state" invisible="not fee_id"/>
                            <field name="amount"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="note"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_event_registration_search" model="ir.ui.view">
        <field name="name">eacta.school.event.registration.search</field>
        <field name="model">eacta.school.event.registration</field>
        <field name="arch" type="xml">
            <search>
                <field name="student_id"/>
                <field name="event_id"/>
                <field name="class_id"/>
                <filter string="Autorisation manquante" name="no_authorization" domain="[('authorized', '=', False)]"/>
                <filter string="Non payé" name="unpaid" domain="[('paid', '=', False), ('amount', '>', 0)]"/>
                <filter string="Absents" name="absent" domain="[('state', '=', 'absent')]"/>
                <group expand="0" string="Regrouper par">
                    <filter string="Événement" name="group_event" context="{'group_by': 'event_id'}"/>
                    <filter string="Classe" name="group_class" context="{'group_by': 'class_id'}"/>
                    <filter string="Statut" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_event_registration" model="ir.actions.act_window">
        <field name="name">Inscriptions</field>
        <field name="res_model">eacta.school.event.registration</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_event_registration_search"/>
        <field name="context">{'search_default_group_event': 1}</field>
    </record>

    <!-- ============================ DÉPENSES ============================ -->
    <record id="view_eacta_event_expense_tree" model="ir.ui.view">
        <field name="name">eacta.school.event.expense.list</field>
        <field name="model">eacta.school.event.expense</field>
        <field name="arch" type="xml">
            <list string="Dépenses Événements" editable="bottom">
                <field name="event_id"/>
                <field name="name"/>
                <field name="expense_type"/>
                <field name="amount" sum="Total"/>
                <field name="vendor"/>
                <field name="payment_date"/>
                <field name="state" widget="badge" decoration-success="state == 'paid'" decoration-info="state == 'planned'"/>
            </list>
        </field>
    </record>

    <record id="action_eacta_event_expense" model="ir.actions.act_window">
        <field name="name">Dépenses &amp; Budget</field>
        <field name="res_model">eacta.school.event.expense</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ============================ MENUS ============================ -->
    <!-- Application autonome Événements -->
    <menuitem id="menu_eacta_event_app_root" name="Événements" sequence="52"
              action="action_eacta_school_event"
              web_icon="eacta_event,static/description/icon.png"
              groups="eacta_event.group_eacta_event_user"/>
    <menuitem id="menu_eacta_event_app_events" name="Événements" parent="menu_eacta_event_app_root"
              action="action_eacta_school_event" sequence="10"/>
    <menuitem id="menu_eacta_event_app_calendar" name="Calendrier" parent="menu_eacta_event_app_root"
              action="action_eacta_school_event_calendar" sequence="20"/>
    <menuitem id="menu_eacta_event_app_registration" name="Inscriptions" parent="menu_eacta_event_app_root"
              action="action_event_registration" sequence="30"/>
    <menuitem id="menu_eacta_event_app_expenses" name="Dépenses &amp; Budget" parent="menu_eacta_event_app_root"
              action="action_eacta_event_expense" sequence="35"/>
    <menuitem id="menu_eacta_event_app_reporting" name="Analyse" parent="menu_eacta_event_app_root"
              action="action_eacta_school_event_analysis" sequence="40"/>

    <!-- Raccourci dans le menu NR School -->
    <menuitem id="menu_eacta_event_root" name="Événements" parent="eacta_school.menu_eacta_school_root" sequence="60"/>
    <menuitem id="menu_eacta_event" name="Événements" parent="menu_eacta_event_root"
              action="action_eacta_school_event" sequence="10"/>
    <menuitem id="menu_eacta_event_registration" name="Inscriptions" parent="menu_eacta_event_root"
              action="action_event_registration" sequence="20"/>
    <menuitem id="menu_eacta_event_expenses" name="Dépenses &amp; Budget" parent="menu_eacta_event_root"
              action="action_eacta_event_expense" sequence="25"/>

    <!-- Bouton et onglet « Événements » sur la fiche élève -->
    <record id="view_eacta_student_form_events" model="ir.ui.view">
        <field name="name">eacta.student.form.events</field>
        <field name="model">eacta.student</field>
        <field name="inherit_id" ref="eacta_school.view_eacta_student_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_events" type="object" class="oe_stat_button" icon="fa-calendar">
                    <field name="event_count" widget="statinfo" string="Événements"/>
                </button>
            </div>
            <notebook position="inside">
                <page string="Événements" name="events" icon="fa-calendar">
                    <div class="mb-2">
                        <button name="action_register_event" type="object" class="btn btn-primary btn-sm"
                                icon="fa-plus" string="Inscrire à un événement"/>
                    </div>
                    <field name="event_registration_ids" readonly="1">
                        <list decoration-muted="state == 'cancelled'" decoration-success="state == 'attended'"
                              decoration-danger="state == 'absent'">
                            <field name="event_id"/>
                            <field name="event_date"/>
                            <field name="authorized" widget="boolean_toggle"/>
                            <field name="paid" widget="boolean_toggle"/>
                            <field name="state" widget="badge" decoration-info="state == 'registered'"
                                   decoration-success="state == 'attended'" decoration-danger="state == 'absent'"/>
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>

</odoo>
