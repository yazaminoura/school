<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Event Rules -->
        <record id="eacta_event_user_rule" model="ir.rule">
            <field name="name">Utilisateur Événements : voir tous les événements</field>
            <field name="model_id" ref="model_eacta_school_event"/>
            <field name="domain_force">[]</field>
            <field name="groups" eval="[(4, ref('group_eacta_event_user'))]"/>
        </record>

        <record id="eacta_event_manager_rule" model="ir.rule">
            <field name="name">Manager Événements : accès complet aux événements</field>
            <field name="model_id" ref="model_eacta_school_event"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_eacta_event_manager'))]"/>
        </record>
    </data>
</odoo>