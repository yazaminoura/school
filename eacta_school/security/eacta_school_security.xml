<?xml version="1.0" encoding="utf-8"?>
<odoo>

   <data>

       <record id="module_category_eacta_school" model="ir.module.category">

           <field name="name">E-ACTA School</field>

           <field name="description">Gestion des utilisateurs pour le module E-ACTA School</field>

           <field name="sequence">20</field>

       </record>

       <record id="group_eacta_school_user" model="res.groups">

           <field name="name">Utilisateur</field>

           <field name="category_id" ref="module_category_eacta_school"/>

           <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>

       </record>



       <!-- Groupe Manager -->

       <record id="group_eacta_school_manager" model="res.groups">

           <field name="name">Manager</field>

           <field name="category_id" ref="module_category_eacta_school"/>

           <field name="implied_ids" eval="[(4, ref('group_eacta_school_user'))]"/>

           <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>

       </record>

   </data>



</odoo>