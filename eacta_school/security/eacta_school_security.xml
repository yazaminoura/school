<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_eacta_school" model="ir.module.category">
            <field name="name">NR School</field>
            <field name="description">Gestion des utilisateurs pour le module NR School</field>
            <field name="sequence">20</field>
        </record>

        <!-- Groupe de base Utilisateur -->
        <record id="group_eacta_school_user" model="res.groups">
            <field name="name">Utilisateur</field>
            <field name="category_id" ref="module_category_eacta_school"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Groupe Enseignant -->
        <record id="group_eacta_school_teacher" model="res.groups">
            <field name="name">Enseignant</field>
            <field name="category_id" ref="module_category_eacta_school"/>
            <field name="implied_ids" eval="[(4, ref('group_eacta_school_user'))]"/>
        </record>

        <!-- Groupe Secrétariat / Accueil -->
        <record id="group_eacta_school_secretary" model="res.groups">
            <field name="name">Secrétariat / Accueil</field>
            <field name="category_id" ref="module_category_eacta_school"/>
            <field name="implied_ids" eval="[(4, ref('group_eacta_school_user'))]"/>
        </record>

        <!-- Groupe Comptabilité / Finances -->
        <record id="group_eacta_school_finance" model="res.groups">
            <field name="name">Comptabilité / Finances</field>
            <field name="category_id" ref="module_category_eacta_school"/>
            <field name="implied_ids" eval="[(4, ref('group_eacta_school_user'))]"/>
        </record>

        <!-- Groupe Infirmerie -->
        <record id="group_eacta_school_nurse" model="res.groups">
            <field name="name">Infirmerie</field>
            <field name="category_id" ref="module_category_eacta_school"/>
            <field name="implied_ids" eval="[(4, ref('group_eacta_school_user'))]"/>
        </record>

        <!-- Groupe Direction / Direction Pédagogique -->
        <record id="group_eacta_school_direction" model="res.groups">
            <field name="name">Direction</field>
            <field name="category_id" ref="module_category_eacta_school"/>
            <field name="implied_ids" eval="[(4, ref('group_eacta_school_teacher')), (4, ref('group_eacta_school_secretary'))]"/>
        </record>

        <!-- Groupe Administration / Manager -->
        <record id="group_eacta_school_manager" model="res.groups">
            <field name="name">Administration (Manager)</field>
            <field name="category_id" ref="module_category_eacta_school"/>
            <field name="implied_ids" eval="[(4, ref('group_eacta_school_direction')), (4, ref('group_eacta_school_finance')), (4, ref('group_eacta_school_nurse'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- Groupe Portail : Parent d'élève -->
        <record id="group_eacta_school_parent" model="res.groups">
            <field name="name">Parent / Tuteur</field>
            <field name="category_id" ref="module_category_eacta_school"/>
            <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <!-- Groupe Portail : Élève -->
        <record id="group_eacta_school_student" model="res.groups">
            <field name="name">Élève</field>
            <field name="category_id" ref="module_category_eacta_school"/>
            <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
        </record>
    </data>
</odoo>