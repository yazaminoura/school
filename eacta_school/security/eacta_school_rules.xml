<?xml version="1.0" encoding="utf-8"?>
<odoo>

   <data noupdate="1">

       <!-- Règle pour les utilisateurs : peuvent voir tous les enregistrements, mais ne peuvent modifier que les leurs -->

       <record id="eacta_student_user_rule" model="ir.rule">

           <field name="name">Utilisateur E-ACTA School : voir tous les élèves, modifier les siens</field>

           <field name="model_id" ref="model_eacta_student"/>

           <field name="domain_force">['|', ('create_uid', '=', user.id), ('write_uid', '=', user.id)]</field>

           <field name="perm_read" eval="True"/>

           <field name="perm_write" eval="True"/>

           <field name="perm_create" eval="True"/>

           <field name="perm_unlink" eval="False"/>

           <field name="groups" eval="[(4, ref('eacta_school.group_eacta_school_user'))]"/>

       </record>



       <!-- Règle pour les managers : accès complet à tous les enregistrements -->

       <record id="eacta_student_manager_rule" model="ir.rule">

           <field name="name">Manager E-ACTA School : accès complet aux élèves</field>

           <field name="model_id" ref="model_eacta_student"/>

           <field name="domain_force">[(1, '=', 1)]</field>

           <field name="groups" eval="[(4, ref('eacta_school.group_eacta_school_manager'))]"/>

       </record>

   </data>

</odoo>