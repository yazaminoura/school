<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Define the Kanban view for the res.partner model -->
    <record id="view_partner_kanban_eacta_school" model="ir.ui.view">
        <field name="name">res.partner.kanban.eacta.school</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id"/>
                <field name="name"/>
                <field name="is_school_parent"/>
                <field name="student_ids"/>
                <field name="avatar_128"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click eacta_card_custom p-3">
                            <div class="d-flex gap-3 align-items-center">
                                <img t-att-src="kanban_image('res.partner', 'avatar_128', record.id.raw_value)"
                                     class="rounded-circle border shadow-sm flex-shrink-0"
                                     style="width: 50px; height: 50px; object-fit: cover;"
                                     alt="Parent Avatar"/>
                                <div class="flex-grow-1 min-w-0">
                                    <h6 class="fw-bold text-dark mb-1 text-truncate">
                                        <field name="name"/>
                                    </h6>
                                    <span t-if="record.is_school_parent.raw_value" class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2 py-0 small">
                                        <i class="fa fa-heart me-1"/> Parent d'élève
                                    </span>
                                </div>
                            </div>
                            <div t-if="record.student_ids.raw_value" class="mt-2 pt-2 border-top">
                                <small class="text-muted d-block mb-1">Élève(s) rattaché(s):</small>
                                <field name="student_ids" widget="many2many_tags"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
       </field>
    </record>




   <!-- Add a menu item to access this Kanban view -->
   <menuitem id="menu_partner_category_form"
             name="Parents"
             parent="menu_eacta_school_root"
             action="base.action_partner_category_form"
             sequence="90"/>
</odoo>
