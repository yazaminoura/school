<?xml version="1.0" encoding="utf-8"?>
<odoo>
   <!-- Define the Kanban view for the res.partner model -->
   <record id="view_partner_kanban_eacta_school" model="ir.ui.view">
       <field name="name">res.partner.kanban.eacta.school</field>
       <field name="model">res.partner</field>
       <field name="arch" type="xml">
           <kanban>
               <templates>
                   <!-- The kanban-box template is mandatory for the Kanban view -->
                   <t t-name="kanban-box">
                       <div class="o_kanban_card">
                           <div class="o_kanban_details">
                               <!-- Display the partner's name -->
                               <strong>
                                   <field name="name"/>
                               </strong>
                             <!-- Display if the partner is a school parent -->
                               <div>
                                   <field name="is_school_parent"/>
                               </div>




                               <!-- Display the list of associated students (as tags) -->
                               <div>
                                   <field name="student_ids" widget="many2many_tags" options="{'no_create': True}"/>
                               </div>




                               <!-- Display the school photo if it's available -->
                               <div t-if="record.school_photo.raw_value">
                                   <img t-att-src="'data:image/png;base64,' + record.school_photo.raw_value"
                                        alt="School Photo" class="img img-fluid"/>
                               </div>
                           </div>
                       </div>
                   </t>
               </templates>
           </kanban>
      </field>
   </record>




   <!-- Add a menu item to access this Kanban view -->
   <menuitem id="menu_partner_category_form"
             name="Parents"
             parent="menu_eacta_school_root"
             action="base.action_partner_category_form"
             sequence="90"/>
</odoo>
