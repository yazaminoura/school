<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form examen -->
    <record id="view_exam_form" model="ir.ui.view">
        <field name="name">eacta.exam.form</field>
        <field name="model">eacta.exam</field>
        <field name="arch" type="xml">
            <form string="Examen">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Nom de l'Examen" class="oe_edit_only"/>
                        <h1 class="d-flex align-items-center gap-2">
                            <i class="fa fa-pencil-square-o text-primary"/>
                            <field name="name" placeholder="ex: Contrôle Continu 1 - Algèbre"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Matière &amp; Calendrier">
                            <field name="course_id" string="Matière" required="True" options="{'no_create': True}"/>
                            <field name="date" string="Date de l'Examen" required="True"/>
                        </group>
                        <group string="Classes Concernées">
                            <field name="class_ids" string="Classes" widget="many2many_tags" required="True"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vue liste des examens -->
    <record id="view_eacta_exam_tree" model="ir.ui.view">
        <field name="name">eacta.exam.list</field>
        <field name="model">eacta.exam</field>
        <field name="arch" type="xml">
            <list string="Liste des Examens" decoration-info="date and date &gt;= current_date">
                <field name="name" string="Nom de l'Examen" class="fw-bold"/>
                <field name="course_id" string="Matière"/>
                <field name="date" string="Date" widget="date"/>
                <field name="class_ids" string="Classes" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <!-- Vue Kanban des examens -->
    <record id="view_eacta_exam_kanban" model="ir.ui.view">
        <field name="name">eacta.exam.kanban</field>
        <field name="model">eacta.exam</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id"/>
                <field name="name"/>
                <field name="course_id"/>
                <field name="date"/>
                <field name="class_ids"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click eacta_card_custom eacta_exam_card p-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-light text-primary border rounded-pill px-2 py-1 small">
                                    <i class="fa fa-book me-1"/>
                                    <field name="course_id"/>
                                </span>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2 py-1 small">
                                    <i class="fa fa-calendar me-1"/>
                                    <field name="date"/>
                                </span>
                            </div>
                            <h5 class="fw-bold text-dark mb-2 text-truncate">
                                <field name="name"/>
                            </h5>
                            <div class="d-flex align-items-center justify-content-between mt-auto pt-2 border-top">
                                <small class="text-muted">
                                    <i class="fa fa-users me-1"/>
                                    Classes:
                                </small>
                                <field name="class_ids" widget="many2many_tags"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Actions examen-->
    <record id="action_eacta_exam" model="ir.actions.act_window">
        <field name="name">Examens</field>
        <field name="res_model">eacta.exam</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Planifiez votre premier examen !
            </p>
            <p>
                Définissez les devoirs, contrôles continus et examens finaux pour chaque matière et classe.
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_eacta_exam"
              name="Examens"
              parent="menu_eacta_school_root"
              action="action_eacta_exam"
              sequence="20"/>
</odoo>