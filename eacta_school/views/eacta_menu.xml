<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_eacta_school_dashboard" model="ir.actions.client">
        <field name="name">Tableau de bord</field>
        <field name="tag">eacta_school.dashboard</field>
    </record>

    <menuitem id="menu_eacta_school_root"
              name="NR School"
              sequence="0"
              action="action_eacta_school_dashboard"
              web_icon="eacta_school,static/src/img/nr_school_icon.png"
              groups="eacta_school.group_eacta_school_user"/>

    <menuitem id="menu_eacta_school_dashboard" name="Tableau de bord" parent="menu_eacta_school_root"
              action="action_eacta_school_dashboard" sequence="1"/>

    <record id="action_eacta_attendance_scan" model="ir.actions.act_url">
        <field name="name">Scanner d'assiduité</field>
        <field name="url">/school/attendance/scan</field>
        <field name="target">new</field>
    </record>

    <!-- Scolarité -->
    <menuitem id="menu_eacta_school_scolarite" name="Scolarité" parent="menu_eacta_school_root" sequence="10"/>
    <menuitem id="menu_eacta_student" name="Élèves" parent="menu_eacta_school_scolarite"
              action="action_eacta_student" sequence="10"/>
    <menuitem id="menu_eacta_class" name="Classes" parent="menu_eacta_school_scolarite"
              action="action_eacta_class" sequence="20"/>
    <menuitem id="menu_eacta_attendance" name="Assiduité &amp; Absences" parent="menu_eacta_school_scolarite"
              action="action_eacta_attendance" sequence="25"/>
    <menuitem id="menu_eacta_take_attendance" name="Faire l'appel" parent="menu_eacta_school_scolarite"
              action="action_eacta_attendance_wizard" sequence="26"/>
    <menuitem id="menu_eacta_attendance_scan_item" name="Scanner d'assiduité (QR)" parent="menu_eacta_school_scolarite"
              action="action_eacta_attendance_scan" sequence="27"/>
    <menuitem id="menu_partner_category_form" name="Parents" parent="menu_eacta_school_scolarite"
              action="action_eacta_school_parents" sequence="30"/>

    <!-- Transport Scolaire -->
    <menuitem id="menu_eacta_school_transport" name="Transport" parent="menu_eacta_school_root" sequence="25"/>
    <menuitem id="menu_eacta_transport_line" name="Lignes de transport" parent="menu_eacta_school_transport"
              action="action_eacta_transport_line" sequence="10"/>
    <menuitem id="menu_eacta_transport_stop" name="Arrêts de bus" parent="menu_eacta_school_transport"
              action="action_eacta_transport_stop" sequence="20"/>

    <!-- Pédagogie -->
    <menuitem id="menu_eacta_school_pedagogie" name="Pédagogie" parent="menu_eacta_school_root" sequence="20"/>
    <menuitem id="menu_eacta_course" name="Cours" parent="menu_eacta_school_pedagogie"
              action="action_eacta_course" sequence="10"/>
    <menuitem id="menu_eacta_exam" name="Examens" parent="menu_eacta_school_pedagogie"
              action="action_eacta_exam" sequence="20"/>
    <menuitem id="menu_eacta_course_grade" name="Notes" parent="menu_eacta_school_pedagogie"
              action="action_eacta_course_grade" sequence="30"/>
    <menuitem id="menu_eacta_student_result" name="Bulletins &amp; Résultats" parent="menu_eacta_school_pedagogie"
              action="action_student_result" sequence="40"/>
    <menuitem id="menu_eacta_class_deliberation" name="PV de délibération" parent="menu_eacta_school_pedagogie"
              action="action_eacta_class_deliberation_wizard" sequence="45"/>


    <!-- Analyse -->
    <menuitem id="menu_eacta_school_reporting" name="Analyse" parent="menu_eacta_school_root" sequence="80"/>
    <menuitem id="menu_eacta_grade_analysis" name="Analyse des notes" parent="menu_eacta_school_reporting"
              action="action_eacta_grade_analysis" sequence="10"/>
    <menuitem id="menu_eacta_attendance_analysis" name="Analyse de l'assiduité" parent="menu_eacta_school_reporting"
              action="action_eacta_attendance_analysis" sequence="20"/>

    <!-- Configuration -->
    <menuitem id="menu_eacta_school_config" name="Configuration" parent="menu_eacta_school_root" sequence="100"
              groups="eacta_school.group_eacta_school_manager"/>
    <menuitem id="menu_eacta_academic_year" name="Années académiques" parent="menu_eacta_school_config"
              action="action_academic_year" sequence="5"/>
    <menuitem id="menu_eacta_term" name="Trimestres / Périodes" parent="menu_eacta_school_config"
              action="action_term" sequence="6"/>
    <menuitem id="menu_eacta_school_level" name="Niveaux scolaires" parent="menu_eacta_school_config"
              action="action_eacta_school_level" sequence="10"/>
    <menuitem id="menu_eacta_course_category" name="Catégories de cours" parent="menu_eacta_school_config"
              action="action_eacta_course_category" sequence="20"/>
    <menuitem id="menu_eacta_teachers" name="Enseignants" parent="menu_eacta_school_config"
              action="action_eacta_teachers" sequence="30"/>
    <menuitem id="menu_eacta_fee_type" name="Types de frais" parent="menu_eacta_school_config"
              action="action_eacta_fee_type" sequence="40"/>
    <menuitem id="menu_eacta_school_settings" name="Paramètres" parent="menu_eacta_school_config"
              action="action_school_config_settings" sequence="100"/>

    <!-- Emploi du temps -->
    <menuitem id="menu_eacta_timetable" name="Emploi du temps" parent="menu_eacta_school_pedagogie"
              action="action_eacta_timetable" sequence="5"/>
    <menuitem id="menu_eacta_timetable_slot" name="Créneaux" parent="menu_eacta_school_pedagogie"
              action="action_eacta_timetable_slot" sequence="6" groups="eacta_school.group_eacta_school_manager"/>

    <!-- Finances -->
    <menuitem id="menu_eacta_school_finance" name="Finances" parent="menu_eacta_school_root" sequence="40"
              groups="eacta_school.group_eacta_school_manager,eacta_school.group_eacta_school_finance"/>
    <menuitem id="menu_eacta_fee_dashboard" name="Tableau de bord financier" parent="menu_eacta_school_finance"
              action="action_eacta_fee_dashboard" sequence="1"/>
    <menuitem id="menu_eacta_student_fee" name="Frais de scolarité" parent="menu_eacta_school_finance"
              action="action_eacta_student_fee" sequence="10"/>
    <menuitem id="menu_eacta_fee_payment" name="Paiements" parent="menu_eacta_school_finance"
              action="action_eacta_fee_payment" sequence="20"/>
    <menuitem id="menu_eacta_fee_generate" name="Générer des frais" parent="menu_eacta_school_finance"
              action="action_eacta_fee_generate_wizard" sequence="30"/>
    <menuitem id="menu_eacta_promotion" name="Passage de fin d'année" parent="menu_eacta_school_scolarite"
              action="action_eacta_promotion_wizard" sequence="90" groups="eacta_school.group_eacta_school_manager"/>

    <!-- Actions de masse pour les élèves -->
    <record id="action_server_enroll_students" model="ir.actions.server">
        <field name="name">Valider les inscriptions</field>
        <field name="model_id" ref="model_eacta_student"/>
        <field name="binding_model_id" ref="model_eacta_student"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
records.filtered(lambda s: s.state == 'draft').action_enroll()
        </field>
    </record>

    <record id="action_server_sync_student_courses" model="ir.actions.server">
        <field name="name">Inscrire aux cours de la classe</field>
        <field name="model_id" ref="model_eacta_student"/>
        <field name="binding_model_id" ref="model_eacta_student"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
records._sync_class_courses()
        </field>
    </record>

</odoo>
