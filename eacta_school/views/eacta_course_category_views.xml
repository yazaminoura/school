<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_eacta_course_category_form" model="ir.ui.view">
        <field name="name">eacta.course.category.form</field>
        <field name="model">eacta.course.category</field>
        <field name="arch" type="xml">
            <form string="Catégorie de cours">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="ex : Sciences &amp; Technologies"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="ex : SCI"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                        <group>
                            <field name="course_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Cours" name="courses">
                            <field name="course_ids" readonly="1">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="teacher_id"/>
                                    <field name="coefficient"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Description des matières de cette catégorie…"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_eacta_course_category_tree" model="ir.ui.view">
        <field name="name">eacta.course.category.list</field>
        <field name="model">eacta.course.category</field>
        <field name="arch" type="xml">
            <list string="Catégories de cours">
                <field name="name"/>
                <field name="code"/>
                <field name="course_count"/>
                <field name="color" widget="color_picker" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_eacta_course_category" model="ir.actions.act_window">
        <field name="name">Catégories de cours</field>
        <field name="res_model">eacta.course.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Créez une catégorie de cours</p>
            <p>Regroupez vos cours par domaine : Sciences, Lettres, Langues, Arts…</p>
        </field>
    </record>

</odoo>
