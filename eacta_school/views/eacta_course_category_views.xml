<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form view definition for course categories -->
    <record id="view_eacta_course_category_form" model="ir.ui.view">
        <field name="name">eacta.course.category.form</field>
        <field name="model">eacta.course.category</field>
        <field name="arch" type="xml">
            <form string="Catégorie de Cours">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Nom de la Catégorie" class="oe_edit_only"/>
                        <h1 class="d-flex align-items-center gap-2">
                            <i class="fa fa-folder-open-o text-primary"/>
                            <field name="name" placeholder="ex: Sciences &amp; Technologies"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Identifiants">
                            <field name="code" placeholder="ex: SCI-TECH" required="True"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" icon="fa-align-left">
                            <field name="description" placeholder="Description des matières rattachées à cette catégorie..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List view definition for course categories -->
    <record id="view_eacta_course_category_tree" model="ir.ui.view">
        <field name="name">eacta.course.category.list</field>
        <field name="model">eacta.course.category</field>
        <field name="arch" type="xml">
            <list string="Catégories de Cours">
                <field name="name" string="Catégorie" class="fw-bold"/>
                <field name="code" string="Code" widget="badge"/>
                <field name="description" string="Description"/>
            </list>
        </field>
    </record>

    <!-- Kanban view definition for course categories -->
    <record id="view_eacta_course_category_kanban" model="ir.ui.view">
        <field name="name">eacta.course.category.kanban</field>
        <field name="model">eacta.course.category</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="code"/>
                <field name="description"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click eacta_card_custom p-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2 py-1 small fw-bold">
                                    <field name="code"/>
                                </span>
                                <i class="fa fa-tags text-primary opacity-50"/>
                            </div>
                            <h5 class="fw-bold text-dark mb-1 text-truncate">
                                <field name="name"/>
                            </h5>
                            <p t-if="record.description.raw_value" class="text-muted small mb-0 text-truncate">
                                <field name="description"/>
                            </p>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action definition for course categories -->
    <record id="action_eacta_course_category" model="ir.actions.act_window">
        <field name="name">Catégories de cours</field>
        <field name="res_model">eacta.course.category</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez une catégorie de cours !
            </p>
            <p>
                Regroupez vos cours par domaine : Sciences, Lettres, Langues, Arts, etc.
            </p>
        </field>
    </record>

    <!-- Parent menu item definition if it doesn't already exist -->
    <menuitem id="menu_eacta_school_config" name="School Configuration" sequence="10"/>

    <!-- Course category menu item definition -->
    <menuitem id="menu_eacta_course_category"
              name="Catégories de cours"
              parent="menu_eacta_school_config"
              action="action_eacta_course_category"
              sequence="20"/>
</odoo>