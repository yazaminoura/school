<?xml version="1.0" encoding="utf-8"?>
<odoo>
   <record id="view_users_form_eacta_school_inherit" model="ir.ui.view">
       <field name="name">res.users.form.eacta.school.inherit</field>
       <field name="model">res.users</field>
       <field name="inherit_id" ref="base.view_users_form"/>
       <field name="arch" type="xml">
           <notebook position="inside">
               <page string="Enseignement">
                   <group>
                       <field name="is_teacher"/>
                       <field name="subject_ids" widget="many2many_tags" options="{'no_create': True}">
                           <list>
                               <field name="name"/>
                           </list>
                           <form>
                               <field name="name"/>
                           </form>
                       </field>
                   </group>
               </page>
           </notebook>
       </field>
   </record>
</odoo>
