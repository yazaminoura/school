<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================== LIST ============================== -->
    <record id="view_eacta_student_tree" model="ir.ui.view">
        <field name="name">eacta.student.list</field>
        <field name="model">eacta.student</field>
        <field name="arch" type="xml">
            <list string="Élèves" multi_edit="1" sample="1"
                  decoration-muted="state == 'alumni'">
                <field name="code" optional="show"/>
                <field name="name"/>
                <field name="current_class_id" optional="show"/>
                <field name="class_ids" widget="many2many_tags" optional="hide"/>
                <field name="date_of_birth" optional="hide"/>
                <field name="age" optional="show"/>
                <field name="gender" optional="show"/>
                <field name="phone" optional="hide"/>
                <field name="parent_ids" widget="many2many_tags" optional="hide"/>
                <field name="average" optional="show"
                       decoration-danger="grade_count and average &lt; 10"
                       decoration-success="average &gt;= 14"/>
                <field name="appreciation" optional="hide"/>
                <field name="grade_count" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'draft'"
                       decoration-success="state == 'enrolled'"
                       decoration-info="state == 'graduated'"/>
            </list>
        </field>
    </record>

    <!-- ============================= SEARCH ============================= -->
    <record id="view_eacta_student_search" model="ir.ui.view">
        <field name="name">eacta.student.search</field>
        <field name="model">eacta.student</field>
        <field name="arch" type="xml">
            <search string="Rechercher des élèves">
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="current_class_id"/>
                <field name="academic_year_id"/>
                <field name="class_ids"/>
                <field name="course_ids"/>
                <field name="parent_ids"/>
                <filter string="Pré-inscriptions" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Inscrits" name="enrolled" domain="[('state', '=', 'enrolled')]"/>
                <filter string="Diplômés" name="graduated" domain="[('state', 'in', ('graduated', 'alumni'))]"/>
                <separator/>
                <filter string="En difficulté (&lt; 10)" name="struggling"
                        domain="[('grade_count', '>', 0), ('average', '&lt;', 10)]"/>
                <filter string="Excellents (≥ 16)" name="excellent" domain="[('average', '>=', 16)]"/>
                <filter string="Sans classe" name="no_class" domain="[('class_ids', '=', False)]"/>
                <separator/>
                <filter string="Transport scolaire (Bus)" name="filter_bus" domain="[('transport_mode', '=', 'bus')]"/>
                <field name="transport_line_id"/>
                <separator/>
                <filter string="Masculin" name="male" domain="[('gender', '=', 'male')]"/>
                <filter string="Féminin" name="female" domain="[('gender', '=', 'female')]"/>
                <separator/>
                <filter string="Archivés" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Regrouper par">
                    <filter string="Classe actuelle" name="group_by_class" context="{'group_by': 'current_class_id'}"/>
                    <filter string="Ligne de transport" name="group_by_transport_line" context="{'group_by': 'transport_line_id'}"/>
                    <filter string="Année académique" name="group_by_academic_year" context="{'group_by': 'academic_year_id'}"/>
                    <filter string="Année" name="group_by_year" context="{'group_by': 'current_year'}"/>
                    <filter string="Genre" name="group_by_gender" context="{'group_by': 'gender'}"/>
                    <filter string="État" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Appréciation" name="group_by_appreciation" context="{'group_by': 'appreciation'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================= KANBAN ============================= -->
    <record id="view_eacta_student_kanban" model="ir.ui.view">
        <field name="name">eacta.student.kanban</field>
        <field name="model">eacta.student</field>
        <field name="arch" type="xml">
            <kanban class="o_eacta_kanban" sample="1" quick_create="false">
                <field name="id"/>
                <field name="name"/>
                <field name="state"/>
                <field name="image_128"/>
                <field name="average"/>
                <field name="grade_count"/>
                <field name="course_count"/>
                <field name="age"/>
                <field name="color"/>
                <field name="current_class_id"/>
                <field name="phone"/>
                <progressbar field="state"
                             colors='{"draft": "warning", "enrolled": "success", "graduated": "info", "alumni": "200"}'/>
                <templates>
                    <t t-name="card" class="p-0">
                        <div t-attf-class="o_eacta_card o_eacta_state_#{record.state.raw_value}">
                            <div class="o_eacta_card_head">
                                <t t-if="record.image_128.raw_value">
                                    <field name="image_128" widget="image" class="o_eacta_avatar"
                                           options="{'img_class': 'o_eacta_avatar_img'}"/>
                                </t>
                                <div t-else="" class="o_eacta_avatar o_eacta_avatar_initials">
                                    <t t-out="(record.name.value or '?').trim().charAt(0).toUpperCase()"/>
                                </div>
                                <div class="flex-grow-1 min-w-0">
                                    <field name="name" class="o_eacta_card_title d-block text-truncate"/>
                                    <div class="o_eacta_card_meta text-truncate">
                                        <field name="code"/>
                                        <t t-if="record.age.raw_value"> · <t t-out="record.age.raw_value"/> ans</t>
                                    </div>
                                </div>
                                <span t-attf-class="o_eacta_badge o_eacta_badge_#{record.state.raw_value}">
                                    <field name="state"/>
                                </span>
                            </div>
                            <div class="o_eacta_card_body">
                                <div class="o_eacta_card_line">
                                    <i class="fa fa-fw fa-users" title="Classe"/>
                                    <field name="current_class_id"/>
                                </div>
                                <div class="o_eacta_card_line" t-if="record.phone.raw_value">
                                    <i class="fa fa-fw fa-phone" title="Téléphone"/>
                                    <field name="phone"/>
                                </div>
                            </div>
                            <div class="o_eacta_card_foot">
                                <span class="text-muted small">
                                    <i class="fa fa-book me-1" title="Cours"/><t t-out="record.course_count.raw_value"/> cours
                                </span>
                                <span t-if="record.grade_count.raw_value"
                                      t-attf-class="o_eacta_score #{record.average.raw_value &gt;= 14 ? 'o_eacta_score_high' : (record.average.raw_value &lt; 10 ? 'o_eacta_score_low' : '')}">
                                    <field name="average"/> / 20
                                </span>
                                <span t-else="" class="text-muted small fst-italic">Pas de note</span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============================= PIVOT / GRAPH ============================= -->
    <record id="eacta_student_view_pivot" model="ir.ui.view">
        <field name="name">eacta.student.pivot</field>
        <field name="model">eacta.student</field>
        <field name="arch" type="xml">
            <pivot string="Analyse des élèves" sample="1">
                <field name="current_class_id" type="row"/>
                <field name="gender" type="col"/>
                <field name="average" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="eacta_student_view_graph" model="ir.ui.view">
        <field name="name">eacta.student.graph</field>
        <field name="model">eacta.student</field>
        <field name="arch" type="xml">
            <graph string="Effectifs" type="bar" sample="1">
                <field name="current_class_id"/>
                <field name="state"/>
            </graph>
        </field>
    </record>

    <record id="view_eacta_student_calendar" model="ir.ui.view">
        <field name="name">eacta.student.calendar</field>
        <field name="model">eacta.student</field>
        <field name="arch" type="xml">
            <calendar string="Anniversaires" date_start="date_of_birth" mode="month" quick_create="0">
                <field name="name"/>
                <field name="current_class_id"/>
            </calendar>
        </field>
    </record>

    <!-- ============================== FORM ============================== -->
    <record id="view_eacta_student_form" model="ir.ui.view">
        <field name="name">eacta.student.form</field>
        <field name="model">eacta.student</field>
        <field name="arch" type="xml">
            <form string="Élève">
                <header>
                    <button name="action_enroll" string="Valider l'inscription" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_declare_attendance" string="Signaler absence / retard" type="object"
                            class="btn-secondary" icon="fa-clock-o" invisible="state == 'draft'"/>
                    <button name="action_open_whatsapp_composer" string="Message WhatsApp" type="object"
                            class="btn-outline-success" icon="fa-whatsapp"/>
                    <button name="action_generate_student_fees" string="Facturer la scolarité" type="object"
                            class="btn-secondary" icon="fa-money" invisible="not current_class_id"/>
                    <button name="action_graduate" string="Diplômer" type="object" class="btn-primary"
                            groups="eacta_school.group_eacta_school_manager" invisible="state != 'enrolled'"/>
                    <button name="action_set_alumni" string="Ancien élève" type="object"
                            groups="eacta_school.group_eacta_school_manager" invisible="state != 'graduated'"/>
                    <button name="action_print_report_card" string="Bulletin" type="object" icon="fa-print"
                            invisible="not grade_count"/>
                    <button name="action_print_student_badge" string="Carte d'élève" type="object" icon="fa-id-badge"
                            class="btn-secondary" invisible="state == 'draft'"/>
                    <button name="action_print_certificate" string="Attestation" type="object" icon="fa-file-text-o"
                            class="btn-secondary" invisible="state == 'draft'"/>
                    <button name="action_regenerate_qr_token" string="Régénérer jeton QR" type="object" icon="fa-refresh"
                            groups="eacta_school.group_eacta_school_manager" invisible="state == 'draft'"
                            confirm="Régénérer le jeton QR invalidera l'ancien QR code. Continuer ?"/>
                    <button name="action_draft" string="Remettre en pré-inscription" type="object"
                            groups="eacta_school.group_eacta_school_manager" invisible="state == 'draft'"
                            confirm="Remettre cet élève en pré-inscription ?"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,enrolled,graduated"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_courses" type="object" class="oe_stat_button" icon="fa-book">
                            <field name="course_count" widget="statinfo" string="Cours"/>
                        </button>
                        <button name="action_view_grades" type="object" class="oe_stat_button" icon="fa-pencil-square-o">
                            <field name="grade_count" widget="statinfo" string="Notes"/>
                        </button>
                        <button name="action_view_attendances" type="object" class="oe_stat_button" icon="fa-clock-o">
                            <field name="absence_count" widget="statinfo" string="Absences"/>
                        </button>
                        <button name="action_view_fees" type="object" class="oe_stat_button" icon="fa-money"
                                groups="eacta_school.group_eacta_school_manager,eacta_school.group_eacta_school_finance">
                            <field name="fee_count" widget="statinfo" string="Frais"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Diplômé" bg_color="text-bg-info" invisible="state != 'graduated'"/>
                    <widget name="web_ribbon" title="Archivé" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <field name="image_128" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <div class="o_eacta_code" invisible="not code">
                            <i class="fa fa-id-card-o me-1" title="Matricule"/><field name="code" class="oe_inline"/>
                        </div>
                        <h1><field name="name" placeholder="Prénom et nom de l'élève"/></h1>
                        <div class="d-flex flex-wrap gap-2 mt-1">
                            <field name="current_class_id" class="o_eacta_chip" invisible="not current_class_id"
                                   options="{'no_open': False}" readonly="1"/>
                            <field name="appreciation" class="o_eacta_chip" invisible="not appreciation"/>
                            <field name="honor_mention" class="o_eacta_chip" invisible="honor_mention == 'none' or not honor_mention"/>
                        </div>
                    </div>

                    <div class="o_eacta_kpis" invisible="not grade_count">
                        <div class="o_eacta_kpi">
                            <span class="o_eacta_kpi_label">Moyenne générale</span>
                            <span class="o_eacta_kpi_value"><field name="average" class="oe_inline"/><small>/20</small></span>
                        </div>
                        <div class="o_eacta_kpi">
                            <span class="o_eacta_kpi_label">GPA (crédits)</span>
                            <span class="o_eacta_kpi_value"><field name="gpa" class="oe_inline"/></span>
                        </div>
                        <div class="o_eacta_kpi" invisible="not class_rank">
                            <span class="o_eacta_kpi_label">Rang dans la classe</span>
                            <span class="o_eacta_kpi_value"><field name="class_rank" class="oe_inline"/><small> / <field name="class_size" class="oe_inline"/></small></span>
                        </div>
                        <div class="o_eacta_kpi">
                            <span class="o_eacta_kpi_label">Notes enregistrées</span>
                            <span class="o_eacta_kpi_value"><field name="grade_count" class="oe_inline"/></span>
                        </div>
                    </div>

                    <group>
                        <group string="Scolarité">
                            <field name="current_class_id" options="{'no_create_edit': True}"
                                   placeholder="Sélectionner la classe..."/>
                            <field name="academic_year_id" readonly="1" invisible="not current_class_id"/>
                            <field name="current_year" invisible="1"/>
                            <field name="enrollment_date"/>
                            <field name="canteen" widget="boolean_toggle"/>
                            <field name="transport_mode"/>
                            <field name="transport_line_id" invisible="transport_mode != 'bus'" options="{'no_create_edit': True}"/>
                            <field name="transport_stop_id" invisible="transport_mode != 'bus' or not transport_line_id" options="{'no_create_edit': True}"/>
                        </group>
                        <group string="Identité &amp; Contact">
                            <field name="date_of_birth"/>
                            <field name="age" invisible="not date_of_birth"/>
                            <field name="gender" widget="radio" options="{'horizontal': true}"/>
                            <field name="parent_ids" widget="many2many_tags" placeholder="Parents ou tuteurs..."
                                   context="{'default_is_school_parent': True}"/>
                            <field name="user_id" placeholder="Compte portail élève..." options="{'no_create_edit': True}"/>
                            <field name="phone" widget="phone"/>
                            <field name="email" widget="email"/>
                            <field name="address" placeholder="Adresse postale"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Résultats" name="results" icon="fa-bar-chart">
                            <div class="d-flex align-items-center gap-3 mb-3 flex-wrap">
                                <label for="selected_year" string="Année"/>
                                <field name="selected_year" class="oe_inline" placeholder="Année en cours"/>
                                <span class="text-muted" invisible="not selected_year_class">
                                    Classe : <field name="selected_year_class" class="oe_inline" readonly="1"/>
                                </span>
                                <span class="ms-auto">
                                    Moyenne de l'année :
                                    <strong><field name="selected_year_average" class="oe_inline"/> / 20</strong>
                                </span>
                            </div>
                            <field name="selected_year_grades" readonly="1">
                                <list decoration-danger="status == 'graded' and grade &lt; 10"
                                      decoration-success="status == 'graded' and grade &gt;= 14"
                                      decoration-muted="status in ('absent', 'exempt', 'pending')">
                                    <field name="date"/>
                                    <field name="course_id"/>
                                    <field name="exam_id"/>
                                    <field name="exam_type" optional="show"/>
                                    <field name="coefficient" optional="show"/>
                                    <field name="status" widget="badge"
                                           decoration-warning="status == 'pending'"
                                           decoration-danger="status == 'absent'"/>
                                    <field name="grade"/>
                                    <field name="appreciation"/>
                                    <field name="comment" optional="hide"/>
                                </list>
                            </field>
                            <separator string="Bulletins &amp; Bilans périodiques" class="mt-4"/>
                            <field name="result_ids" readonly="1">
                                <list>
                                    <field name="academic_year_id"/>
                                    <field name="result_type"/>
                                    <field name="term_id" invisible="result_type == 'year'"/>
                                    <field name="average" widget="float" digits="[4, 2]"/>
                                    <field name="class_average" widget="float" digits="[4, 2]"/>
                                    <field name="rank"/>
                                    <field name="class_size"/>
                                    <field name="appreciation" widget="badge"/>
                                    <field name="honor_mention" widget="badge" optional="show"/>
                                    <field name="passed" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        <page string="Cours" name="courses" icon="fa-book">
                            <div class="d-flex align-items-center gap-3 mb-3 p-2 bg-light rounded border">
                                <span class="text-muted small">
                                    <i class="fa fa-info-circle me-1 text-primary"/>
                                    Les cours de la classe sont affectés automatiquement. Vous pouvez ajouter des cours optionnels ou spécifiques ci-dessous.
                                </span>
                                <span class="badge bg-primary-subtle text-primary border ms-auto">
                                    <field name="class_course_count" class="fw-bold me-1"/> matière(s) de classe
                                </span>
                                <span class="badge bg-secondary-subtle text-secondary border">
                                    <field name="elective_course_count" class="fw-bold me-1"/> optionnelle(s)
                                </span>
                            </div>
                            <field name="course_ids">
                                <list editable="bottom">
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="category_id"/>
                                    <field name="teacher_id"/>
                                    <field name="coefficient"/>
                                    <field name="credits"/>
                                </list>
                            </field>
                        </page>
                        <page string="Parcours" name="classes" icon="fa-history">
                            <field name="class_ids">
                                <list>
                                    <field name="academic_year_id"/>
                                    <field name="year" column_invisible="1"/>
                                    <field name="name"/>
                                    <field name="level"/>
                                    <field name="teacher_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Assiduité" name="attendances" icon="fa-calendar-check-o">
                            <div class="d-flex align-items-center gap-3 mb-3 flex-wrap">
                                <span class="badge bg-danger-subtle text-danger border p-2">
                                    <i class="fa fa-times-circle me-1" title="Absences"/> Non justifiées : <field name="unjustified_absence_count" class="fw-bold"/>
                                </span>
                                <span class="badge bg-warning-subtle text-warning border p-2">
                                    <i class="fa fa-clock-o me-1" title="Retards"/> Retards : <field name="late_count" class="fw-bold"/>
                                </span>
                                <button name="action_declare_attendance" type="object" string="Signaler absence / retard"
                                        icon="fa-plus" class="btn btn-secondary btn-sm ms-auto"/>
                            </div>
                            <field name="attendance_ids">
                                <list editable="bottom" decoration-danger="attendance_type == 'absent' and not justified" decoration-warning="attendance_type == 'late'">
                                    <field name="date"/>
                                    <field name="attendance_type" widget="badge"
                                           decoration-danger="attendance_type == 'absent'"
                                           decoration-warning="attendance_type == 'late'"
                                           decoration-success="attendance_type == 'present'"/>
                                    <field name="session"/>
                                    <field name="duration_hours" string="Durée (h)"/>
                                    <field name="justified" widget="boolean_toggle"/>
                                    <field name="reason"/>
                                    <field name="justification_note"/>
                                </list>
                            </field>
                        </page>
                        <page string="Santé &amp; Urgence" name="health_emergency" icon="fa-heartbeat">
                            <group>
                                <group string="Urgence">
                                    <field name="emergency_contact_name"/>
                                    <field name="emergency_contact_phone" widget="phone"/>
                                    <field name="emergency_contact_relation"/>
                                </group>
                                <group string="Médical">
                                    <field name="blood_group"/>
                                    <field name="allergies" placeholder="Allergies connues..."/>
                                    <field name="medical_notes" placeholder="Protocole médical, PAI..."/>
                                </group>
                            </group>
                        </page>
                        <page string="Commentaire" name="comment" icon="fa-comment-o">
                            <field name="student_comment" placeholder="Observations, besoins particuliers…"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================= ACTION ============================= -->
    <record id="action_eacta_student" model="ir.actions.act_window">
        <field name="name">Élèves</field>
        <field name="res_model">eacta.student</field>
        <field name="view_mode">kanban,list,form,pivot,graph,calendar</field>
        <field name="search_view_id" ref="view_eacta_student_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Inscrivez votre premier élève</p>
            <p>Gérez les dossiers, les classes, les parents et les résultats de vos élèves.</p>
        </field>
    </record>

</odoo>
