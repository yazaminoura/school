<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_course_grade_tree" model="ir.ui.view">
   <field name="name">eacta.course.grade.tree</field>
   <field name="model">eacta.course.grade</field>
   <field name="arch" type="xml">
       <tree string="Notes des étudiants">
           <field name="student_id"/>
           <field name="grade"/>
       </tree>
   </field>
</record>


<record id="view_course_grade_form" model="ir.ui.view">
   <field name="name">eacta.course.grade.form</field>
   <field name="model">eacta.course.grade</field>
   <field name="arch" type="xml">
       <form string="Note">
           <sheet>
               <group>
                   <field name="course_id"/>
                   <field name="student_id"/>
                   <field name="exam_id"/>
                   <field name="grade"/>
               </group>
           </sheet>
       </form>
   </field>
</record>


</odoo>
