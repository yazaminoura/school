<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_course_grade_tree" model="ir.ui.view">
        <field name="name">eacta.course.grade.list</field>
        <field name="model">eacta.course.grade</field>
        <field name="arch" type="xml">
            <list string="Notes" sample="1"
                  decoration-danger="status == 'graded' and grade &lt; 10"
                  decoration-success="status == 'graded' and grade &gt;= 14"
                  decoration-muted="status in ('absent', 'exempt')">
                <field name="date"/>
                <field name="academic_year_id" optional="show"/>
                <field name="term_id" optional="show"/>
                <field name="student_id"/>
                <field name="class_id" optional="show"/>
                <field name="course_id"/>
                <field name="exam_id"/>
                <field name="exam_type" optional="hide"/>
                <field name="coefficient" optional="hide"/>
                <field name="status" widget="badge" decoration-warning="status == 'pending'"
                       decoration-danger="status == 'absent'"/>
                <field name="grade"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'submitted'"
                       decoration-primary="state == 'validated'"
                       decoration-success="state == 'published'"/>
                <field name="appreciation" optional="show"/>
                <field name="comment" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Grille de saisie rapide (ouverte depuis l'examen) -->
    <record id="view_course_grade_entry_list" model="ir.ui.view">
        <field name="name">eacta.course.grade.entry.list</field>
        <field name="model">eacta.course.grade</field>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <list string="Saisie des notes" editable="top" create="1"
                  default_order="class_id, student_id"
                  decoration-danger="status == 'graded' and grade &lt; 10"
                  decoration-success="status == 'graded' and grade &gt;= 14"
                  decoration-muted="status in ('absent', 'exempt')">
                <field name="exam_id" column_invisible="1"/>
                <field name="student_id" options="{'no_create': True}"/>
                <field name="class_id" options="{'no_create': True}"/>
                <field name="status" widget="badge" decoration-warning="status == 'pending'"
                       decoration-danger="status == 'absent'"/>
                <field name="grade" invisible="status in ('absent', 'exempt')" class="fw-bold"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'submitted'"
                       decoration-primary="state == 'validated'"
                       decoration-success="state == 'published'"/>
                <field name="appreciation"/>
                <field name="comment"/>
            </list>
        </field>
    </record>

    <record id="view_course_grade_form" model="ir.ui.view">
        <field name="name">eacta.course.grade.form</field>
        <field name="model">eacta.course.grade</field>
        <field name="arch" type="xml">
            <form string="Note">
                <header>
                    <button name="action_submit" string="Soumettre" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_validate" string="Valider" type="object" class="btn-primary" groups="eacta_school.group_eacta_school_direction,eacta_school.group_eacta_school_manager" invisible="state not in ('draft', 'submitted')"/>
                    <button name="action_publish" string="Publier" type="object" class="btn-success" groups="eacta_school.group_eacta_school_direction,eacta_school.group_eacta_school_manager" invisible="state != 'validated'"/>
                    <button name="action_draft" string="Remettre en brouillon" type="object" class="btn-secondary" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,validated,published"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="student_id"/>
                        <h1><field name="student_id" options="{'no_create': True}" placeholder="Élève…"/></h1>
                    </div>
                    <group>
                        <group string="Évaluation">
                            <field name="academic_year_id" options="{'no_create': True}"/>
                            <field name="term_id" options="{'no_create': True}"/>
                            <field name="year" invisible="1"/>
                            <field name="exam_id" options="{'no_create': True}"/>
                            <field name="course_id"/>
                            <field name="class_id" options="{'no_create': True}"/>
                            <field name="date"/>
                        </group>
                        <group string="Résultat">
                            <field name="status"/>
                            <label for="grade" invisible="status in ('absent', 'exempt')"/>
                            <div class="d-flex align-items-baseline gap-2" invisible="status in ('absent', 'exempt')">
                                <field name="grade" class="oe_inline fw-bold fs-4"/>
                                <span class="fs-5 text-muted">/ 20</span>
                            </div>
                            <field name="appreciation"/>
                            <field name="comment"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_course_grade_search" model="ir.ui.view">
        <field name="name">eacta.course.grade.search</field>
        <field name="model">eacta.course.grade</field>
        <field name="arch" type="xml">
            <search string="Rechercher des notes">
                <field name="student_id"/>
                <field name="course_id"/>
                <field name="exam_id"/>
                <field name="class_id"/>
                <field name="academic_year_id"/>
                <field name="term_id"/>
                <field name="year"/>
                <filter string="Mes matières" name="my_courses" domain="[('teacher_id', '=', uid)]"/>
                <separator/>
                <filter string="Brouillon" name="state_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Soumises" name="state_submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Validées" name="state_validated" domain="[('state', '=', 'validated')]"/>
                <filter string="Publiées" name="state_published" domain="[('state', '=', 'published')]"/>
                <separator/>
                <filter string="À noter" name="pending" domain="[('status', '=', 'pending')]"/>
                <filter string="Notées" name="graded" domain="[('status', '=', 'graded')]"/>
                <filter string="Absents" name="absent" domain="[('status', '=', 'absent')]"/>
                <separator/>
                <filter string="Sous la moyenne" name="failed" domain="[('status', '=', 'graded'), ('grade', '&lt;', 10)]"/>
                <filter string="Date" name="filter_date" date="date"/>
                <group expand="0" string="Regrouper par">
                    <filter string="État" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Année académique" name="group_by_academic_year" context="{'group_by': 'academic_year_id'}"/>
                    <filter string="Trimestre" name="group_by_term" context="{'group_by': 'term_id'}"/>
                    <filter string="Élève" name="group_by_student" context="{'group_by': 'student_id'}"/>
                    <filter string="Classe" name="group_by_class" context="{'group_by': 'class_id'}"/>
                    <filter string="Matière" name="group_by_course" context="{'group_by': 'course_id'}"/>
                    <filter string="Examen" name="group_by_exam" context="{'group_by': 'exam_id'}"/>
                    <filter string="Année" name="group_by_year" context="{'group_by': 'year'}"/>
                    <filter string="Appréciation" name="group_by_appreciation" context="{'group_by': 'appreciation'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_course_grade_pivot" model="ir.ui.view">
        <field name="name">eacta.course.grade.pivot</field>
        <field name="model">eacta.course.grade</field>
        <field name="arch" type="xml">
            <pivot string="Analyse des notes" sample="1">
                <field name="class_id" type="row"/>
                <field name="course_id" type="col"/>
                <field name="grade" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_course_grade_graph" model="ir.ui.view">
        <field name="name">eacta.course.grade.graph</field>
        <field name="model">eacta.course.grade</field>
        <field name="arch" type="xml">
            <graph string="Moyennes par matière" type="bar" sample="1">
                <field name="course_id"/>
                <field name="grade" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_eacta_course_grade" model="ir.actions.act_window">
        <field name="name">Notes</field>
        <field name="res_model">eacta.course.grade</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="search_view_id" ref="view_course_grade_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucune note pour le moment</p>
            <p>Ouvrez un examen et cliquez sur « Générer la feuille de notes » pour saisir les notes de toute une classe.</p>
        </field>
    </record>

    <record id="action_eacta_grade_analysis" model="ir.actions.act_window">
        <field name="name">Analyse des notes</field>
        <field name="res_model">eacta.course.grade</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="view_course_grade_search"/>
        <field name="context">{'search_default_graded': 1}</field>
    </record>

</odoo>
