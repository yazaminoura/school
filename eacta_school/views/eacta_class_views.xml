<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_eacta_class_form" model="ir.ui.view">
        <field name="name">eacta.class.form</field>
        <field name="model">eacta.class</field>
        <field name="arch" type="xml">
            <form string="Classe">
                <header>
                    <button name="action_sync_courses_to_students" string="Inscrire les élèves aux cours"
                            type="object" class="btn-primary" invisible="not course_ids or not student_ids"
                            help="Ajoute tous les cours de la classe à chaque élève"/>
                    <button name="%(eacta_school.action_report_class_results)d" string="Résultats"
                            type="action" icon="fa-print"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_students" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="student_count" widget="statinfo" string="Élèves"/>
                        </button>
                        <button name="action_view_courses" type="object" class="oe_stat_button" icon="fa-book">
                            <field name="course_count" widget="statinfo" string="Cours"/>
                        </button>
                        <button name="action_view_exams" type="object" class="oe_stat_button" icon="fa-calendar-check-o">
                            <field name="exam_count" widget="statinfo" string="Examens"/>
                        </button>
                        <button name="action_view_grades" type="object" class="oe_stat_button" icon="fa-line-chart">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="average" widget="float" digits="[4, 2]"/></span>
                                <span class="o_stat_text">Moyenne</span>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archivée" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="ex : 6ème A"/></h1>
                    </div>

                    <div class="o_eacta_kpis">
                        <div class="o_eacta_kpi">
                            <span class="o_eacta_kpi_label">Remplissage</span>
                            <span class="o_eacta_kpi_value"><field name="student_count" class="oe_inline"/><small> / <field name="capacity" class="oe_inline" readonly="1"/></small></span>
                            <field name="fill_rate" widget="progressbar" class="o_eacta_kpi_bar"/>
                        </div>
                        <div class="o_eacta_kpi">
                            <span class="o_eacta_kpi_label">Places disponibles</span>
                            <span class="o_eacta_kpi_value"><field name="available_seats" class="oe_inline"/></span>
                        </div>
                        <div class="o_eacta_kpi">
                            <span class="o_eacta_kpi_label">Taux de réussite</span>
                            <span class="o_eacta_kpi_value"><field name="success_rate" class="oe_inline"/><small> %</small></span>
                        </div>
                    </div>

                    <group>
                        <group string="Organisation">
                            <field name="year"/>
                            <field name="level"/>
                            <field name="level_id" options="{'no_create': True}"/>
                            <field name="teacher_id" options="{'no_create': True}"/>
                            <field name="capacity"/>
                        </group>
                        <group string="Calendrier">
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Élèves" name="students" icon="fa-users">
                            <field name="student_ids" context="{'default_class_ids': [id]}">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="gender"/>
                                    <field name="age"/>
                                    <field name="average"/>
                                    <field name="state" widget="badge"
                                           decoration-warning="state == 'draft'"
                                           decoration-success="state == 'enrolled'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Cours" name="courses" icon="fa-book">
                            <field name="course_ids">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="teacher_id"/>
                                    <field name="coefficient"/>
                                    <field name="duration"/>
                                    <field name="grade"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_eacta_class_tree" model="ir.ui.view">
        <field name="name">eacta.class.list</field>
        <field name="model">eacta.class</field>
        <field name="arch" type="xml">
            <list string="Classes" sample="1">
                <field name="year"/>
                <field name="name"/>
                <field name="level"/>
                <field name="level_id" optional="hide"/>
                <field name="teacher_id"/>
                <field name="student_count" sum="Total"/>
                <field name="capacity" sum="Total"/>
                <field name="fill_rate" widget="progressbar"/>
                <field name="course_count" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_eacta_class_search" model="ir.ui.view">
        <field name="name">eacta.class.search</field>
        <field name="model">eacta.class</field>
        <field name="arch" type="xml">
            <search string="Rechercher des classes">
                <field name="name"/>
                <field name="year"/>
                <field name="teacher_id"/>
                <field name="student_ids"/>
                <filter string="Primaire" name="primary" domain="[('level', '=', 'primary')]"/>
                <filter string="Secondaire" name="secondary" domain="[('level', '=', 'secondary')]"/>
                <filter string="Supérieur" name="higher" domain="[('level', '=', 'higher')]"/>
                <separator/>
                <filter string="Complètes" name="full" domain="[('available_seats', '=', 0)]"/>
                <filter string="Places disponibles" name="available" domain="[('available_seats', '>', 0)]"/>
                <separator/>
                <filter string="Archivées" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Regrouper par">
                    <filter string="Année" name="group_by_year" context="{'group_by': 'year'}"/>
                    <filter string="Cycle" name="group_by_level" context="{'group_by': 'level'}"/>
                    <filter string="Niveau" name="group_by_level_id" context="{'group_by': 'level_id'}"/>
                    <filter string="Enseignant" name="group_by_teacher" context="{'group_by': 'teacher_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_eacta_class_kanban" model="ir.ui.view">
        <field name="name">eacta.class.kanban</field>
        <field name="model">eacta.class</field>
        <field name="arch" type="xml">
            <kanban class="o_eacta_kanban" sample="1" quick_create="false">
                <field name="level"/>
                <field name="student_count"/>
                <field name="capacity"/>
                <field name="fill_rate"/>
                <field name="course_count"/>
                <field name="teacher_id"/>
                <templates>
                    <t t-name="card" class="p-0">
                        <div t-attf-class="o_eacta_card o_eacta_level_#{record.level.raw_value}">
                            <div class="o_eacta_card_head">
                                <div class="o_eacta_icon_tile"><i class="fa fa-users" title="Classe"/></div>
                                <div class="flex-grow-1 min-w-0">
                                    <field name="name" class="o_eacta_card_title d-block text-truncate"/>
                                    <div class="o_eacta_card_meta"><field name="level"/></div>
                                </div>
                                <span class="o_eacta_badge o_eacta_badge_primary"><field name="year"/></span>
                            </div>
                            <div class="o_eacta_card_body">
                                <div class="o_eacta_card_line" t-if="record.teacher_id.raw_value">
                                    <i class="fa fa-fw fa-user" title="Enseignant principal"/>
                                    <field name="teacher_id"/>
                                </div>
                                <div class="o_eacta_meter">
                                    <div class="d-flex justify-content-between small">
                                        <span class="text-muted">Effectif</span>
                                        <strong><t t-out="record.student_count.raw_value"/> / <t t-out="record.capacity.raw_value"/></strong>
                                    </div>
                                    <div class="o_eacta_meter_track">
                                        <div t-attf-class="o_eacta_meter_fill #{record.fill_rate.raw_value &gt;= 100 ? 'o_eacta_meter_full' : (record.fill_rate.raw_value &gt;= 85 ? 'o_eacta_meter_warn' : '')}"
                                             t-attf-style="width: #{Math.min(record.fill_rate.raw_value, 100)}%"/>
                                    </div>
                                </div>
                            </div>
                            <div class="o_eacta_card_foot">
                                <span class="text-muted small">
                                    <i class="fa fa-book me-1" title="Cours"/><t t-out="record.course_count.raw_value"/> cours
                                </span>
                                <a name="action_view_students" type="object" class="small fw-semibold">
                                    Voir les élèves <i class="fa fa-arrow-right ms-1" title="Ouvrir"/>
                                </a>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_eacta_class_calendar" model="ir.ui.view">
        <field name="name">eacta.class.calendar</field>
        <field name="model">eacta.class</field>
        <field name="arch" type="xml">
            <calendar string="Classes" date_start="start_date" date_stop="end_date" color="level" mode="year">
                <field name="name"/>
                <field name="teacher_id"/>
                <field name="student_count"/>
            </calendar>
        </field>
    </record>

    <record id="action_eacta_class" model="ir.actions.act_window">
        <field name="name">Classes</field>
        <field name="res_model">eacta.class</field>
        <field name="view_mode">kanban,list,form,calendar</field>
        <field name="search_view_id" ref="view_eacta_class_search"/>
        <field name="context">{'search_default_group_by_year': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Créez votre première classe</p>
            <p>Organisez les élèves par année, cycle et niveau, et suivez le remplissage en temps réel.</p>
        </field>
    </record>

</odoo>
