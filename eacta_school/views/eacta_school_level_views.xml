<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_eacta_school_level_form" model="ir.ui.view">
        <field name="name">eacta.school.level.form</field>
        <field name="model">eacta.school.level</field>
        <field name="arch" type="xml">
            <form string="Niveau scolaire">
                <sheet>
                    <widget name="web_ribbon" title="Archivé" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="ex : Collège - 1ère année"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="ex : COL1"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="class_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Classes" name="classes">
                            <field name="class_ids" readonly="1">
                                <list>
                                    <field name="year"/>
                                    <field name="name"/>
                                    <field name="student_count"/>
                                    <field name="fill_rate" widget="progressbar"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_eacta_school_level_tree" model="ir.ui.view">
        <field name="name">eacta.school.level.list</field>
        <field name="model">eacta.school.level</field>
        <field name="arch" type="xml">
            <list string="Niveaux scolaires" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="class_count"/>
            </list>
        </field>
    </record>

    <record id="action_eacta_school_level" model="ir.actions.act_window">
        <field name="name">Niveaux scolaires</field>
        <field name="res_model">eacta.school.level</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Définissez vos niveaux scolaires</p>
            <p>Primaire, Collège, Lycée… Ils servent à organiser les classes.</p>
        </field>
    </record>

</odoo>
