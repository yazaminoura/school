<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_eacta_grade_sheet_wizard_form" model="ir.ui.view">
        <field name="name">eacta.grade.sheet.wizard.form</field>
        <field name="model">eacta.grade.sheet.wizard</field>
        <field name="arch" type="xml">
            <form string="Grille de saisie rapide des notes">
                <sheet>
                    <!-- Filtres & Contexte -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-3">
                            <label for="class_id" class="fw-bold"/>
                            <field name="class_id" options="{'no_create': True}" placeholder="Sélectionner la classe..."/>
                        </div>
                        <div class="col-md-3">
                            <label for="course_id" class="fw-bold"/>
                            <field name="course_id" options="{'no_create': True}" placeholder="Sélectionner la matière..."/>
                        </div>
                        <div class="col-md-3">
                            <label for="exam_id" class="fw-bold"/>
                            <field name="exam_id" options="{'no_create': True}" placeholder="Examen existant (optionnel)..."/>
                        </div>
                        <div class="col-md-3">
                            <label for="exam_date" class="fw-bold"/>
                            <field name="exam_date"/>
                        </div>
                    </div>

                    <div class="row g-3 mb-3" invisible="exam_id">
                        <div class="col-md-6">
                            <label for="new_exam_name" class="fw-bold"/>
                            <field name="new_exam_name" placeholder="ex: Contrôle continu n°2 - Trigonométrie"/>
                        </div>
                        <div class="col-md-3">
                            <label for="exam_type" class="fw-bold"/>
                            <field name="exam_type"/>
                        </div>
                        <div class="col-md-3">
                            <label for="term_id" class="fw-bold"/>
                            <field name="term_id" options="{'no_create': True}"/>
                        </div>
                    </div>

                    <!-- Bandeau Statistiques en temps réel -->
                    <div class="alert alert-light border d-flex flex-wrap align-items-center justify-content-between p-2 mb-3">
                        <div class="d-flex align-items-center me-3">
                            <i class="fa fa-users text-primary fa-lg me-2"/>
                            <div>
                                <small class="text-muted d-block">Effectif</small>
                                <strong><field name="student_count" class="oe_inline"/> élèves</strong>
                            </div>
                        </div>
                        <div class="d-flex align-items-center me-3">
                            <i class="fa fa-check-circle text-success fa-lg me-2"/>
                            <div>
                                <small class="text-muted d-block">Copies notées</small>
                                <strong><field name="graded_count" class="oe_inline"/> / <field name="student_count" class="oe_inline"/></strong>
                            </div>
                        </div>
                        <div class="d-flex align-items-center me-3">
                            <i class="fa fa-calculator text-info fa-lg me-2"/>
                            <div>
                                <small class="text-muted d-block">Moyenne classe</small>
                                <strong class="fs-6 text-primary"><field name="class_average" class="oe_inline"/> <small>/20</small></strong>
                            </div>
                        </div>
                        <div class="d-flex align-items-center me-3">
                            <i class="fa fa-trophy text-warning fa-lg me-2"/>
                            <div>
                                <small class="text-muted d-block">Taux de réussite</small>
                                <strong><field name="success_rate" class="oe_inline"/> %</strong>
                            </div>
                        </div>
                        <div class="d-flex align-items-center me-3">
                            <i class="fa fa-arrows-h text-secondary fa-lg me-2"/>
                            <div>
                                <small class="text-muted d-block">Min · Max</small>
                                <strong><field name="min_grade" class="oe_inline"/> · <field name="max_grade" class="oe_inline"/></strong>
                            </div>
                        </div>
                        <div class="d-flex align-items-center">
                            <i class="fa fa-user-times text-danger fa-lg me-2"/>
                            <div>
                                <small class="text-muted d-block">Absents</small>
                                <strong><field name="absent_count" class="oe_inline"/></strong>
                            </div>
                        </div>
                    </div>

                    <!-- Grille de saisie tabulaire -->
                    <field name="line_ids" nolabel="1">
                        <list editable="bottom" create="false" delete="false">
                            <field name="student_code" optional="show" string="Matricule"/>
                            <field name="student_id" widget="many2one_avatar" readonly="1" string="Élève"/>
                            <field name="status" widget="badge"
                                   decoration-success="status == 'graded'"
                                   decoration-danger="status == 'absent'"
                                   decoration-warning="status == 'exempt'"
                                   decoration-muted="status == 'pending'"/>
                            <field name="grade" string="Note (/20)"
                                   decoration-danger="status == 'graded' and grade &lt; 10"
                                   decoration-success="status == 'graded' and grade &gt;= 14"/>
                            <field name="appreciation" widget="badge" optional="show"
                                   decoration-success="appreciation in ('good', 'very_good', 'excellent')"
                                   decoration-info="appreciation in ('quite_good', 'fair')"
                                   decoration-danger="appreciation == 'insufficient'"/>
                            <field name="comment" placeholder="Observation..."/>
                            <field name="existing_grade_id" column_invisible="1"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_save_grades" string="Enregistrer les notes" type="object"
                            class="btn-primary" icon="fa-floppy-o"/>
                    <button name="action_submit_grades" string="Enregistrer &amp; Soumettre" type="object"
                            class="btn-success ms-2" icon="fa-check-circle"/>
                    <button name="action_load_students" string="Recharger les élèves" type="object"
                            class="btn-secondary ms-2" icon="fa-refresh"/>
                    <button string="Fermer" class="btn-link ms-auto" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_eacta_grade_sheet_wizard" model="ir.actions.act_window">
        <field name="name">Saisie rapide des notes</field>
        <field name="res_model">eacta.grade.sheet.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
