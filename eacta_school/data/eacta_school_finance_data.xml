<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Activation de la devise MAD (Dirham marocain) -->
    <record id="base.MAD" model="res.currency">
        <field name="active" eval="True"/>
    </record>

    <data noupdate="1">

        <record id="seq_eacta_student_fee" model="ir.sequence">
            <field name="name">Frais de scolarité</field>
            <field name="code">eacta.student.fee</field>
            <field name="prefix">FRS/%(year)s/</field>
            <field name="padding">5</field>
        </record>

        <record id="seq_eacta_fee_payment" model="ir.sequence">
            <field name="name">Reçus de paiement</field>
            <field name="code">eacta.fee.payment</field>
            <field name="prefix">REC/%(year)s/</field>
            <field name="padding">5</field>
        </record>

        <record id="fee_type_registration" model="eacta.fee.type">
            <field name="name">Frais d'inscription</field>
            <field name="sequence">1</field>
            <field name="default_amount">1500</field>
        </record>
        <record id="fee_type_tuition" model="eacta.fee.type">
            <field name="name">Scolarité</field>
            <field name="sequence">2</field>
            <field name="default_amount">12000</field>
        </record>
        <record id="fee_type_transport" model="eacta.fee.type">
            <field name="name">Transport scolaire</field>
            <field name="sequence">3</field>
            <field name="default_amount">3000</field>
        </record>
        <record id="fee_type_canteen" model="eacta.fee.type">
            <field name="name">Cantine</field>
            <field name="sequence">4</field>
            <field name="default_amount">4000</field>
        </record>
        <record id="fee_type_activities" model="eacta.fee.type">
            <field name="name">Activités parascolaires</field>
            <field name="sequence">5</field>
            <field name="default_amount">800</field>
        </record>

        <!-- Modèle d'email de rappel d'échéance des frais -->
        <record id="email_template_fee_reminder" model="mail.template">
            <field name="name">NR School : Rappel d'échéance de frais scolaires</field>
            <field name="model_id" ref="model_eacta_student_fee"/>
            <field name="subject">Rappel de paiement : Frais scolaires en retard - {{ object.student_id.name }}</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.parent_id.email or (object.student_id.parent_ids and object.student_id.parent_ids[0].email) }}</field>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; font-size: 14px; color: #333333;">
                    <p>Bonjour <t t-out="object.parent_id.name or 'Chers parents'"/>,</p>
                    <p>Sauf erreur de notre part, nous vous informons que le paiement des frais scolaires ci-dessous pour l'élève <strong><t t-out="object.student_id.name"/></strong> (Matricule : <strong><t t-out="object.student_code or '-'"/></strong>, Classe : <strong><t t-out="object.class_id.name or '-'"/></strong>) est arrivé à échéance :</p>
                    <table style="width: 100%; max-width: 600px; border-collapse: collapse; margin: 15px 0;">
                        <tr style="background-color: #f8f9fa;">
                            <td style="padding: 8px; border: 1px solid #dee2e6;"><strong>Référence</strong></td>
                            <td style="padding: 8px; border: 1px solid #dee2e6;"><t t-out="object.name"/></td>
                        </tr>
                        <tr>
                            <td style="padding: 8px; border: 1px solid #dee2e6;"><strong>Libellé</strong></td>
                            <td style="padding: 8px; border: 1px solid #dee2e6;"><t t-out="object.description or object.fee_type_id.name"/></td>
                        </tr>
                        <tr style="background-color: #f8f9fa;">
                            <td style="padding: 8px; border: 1px solid #dee2e6;"><strong>Date d'échéance</strong></td>
                            <td style="padding: 8px; border: 1px solid #dee2e6;"><t t-out="object.due_date"/></td>
                        </tr>
                        <tr>
                            <td style="padding: 8px; border: 1px solid #dee2e6;"><strong>Montant restant dû</strong></td>
                            <td style="padding: 8px; border: 1px solid #dee2e6; color: #dc3545; font-weight: bold;"><t t-out="'%.2f' % object.amount_due"/> <t t-out="object.currency_id.symbol or 'DH'"/></td>
                        </tr>
                    </table>
                    <p>Nous vous prions de bien vouloir régulariser cette situation auprès de la comptabilité de l'établissement dans les plus brefs délais.</p>
                    <p style="direction: rtl; text-align: right; color: #555555; margin-top: 15px;">
                        نرجو منكم تسوية هذا الواجب المدرسي في أقرب الآجال لدى مصلحة المحاسبة بالمؤسسة. وشكراً لتعاونكم.
                    </p>
                    <p>Cordialement,<br/><strong>La Direction de l'établissement</strong></p>
                </div>
            </field>
        </record>

        <!-- Action planifiée : Rappel & pénalités de retard -->
        <record id="ir_cron_check_overdue_fees" model="ir.cron">
            <field name="name">NR School : Contrôle des frais en retard, relances et pénalités</field>
            <field name="model_id" ref="model_eacta_student_fee"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_overdue_fees()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
