<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_eacta_student_fee" model="ir.sequence">
            <field name="name">Frais de scolarité</field>
            <field name="code">eacta.student.fee</field>
            <field name="prefix">FRS/%(year)s/</field>
            <field name="padding">5</field>
        </record>

        <record id="seq_eacta_fee_payment" model="ir.sequence">
            <field name="name">Reçus de paiement</field>
            <field name="code">eacta.fee.payment</field>
            <field name="prefix">REC/%(year)s/</field>
            <field name="padding">5</field>
        </record>

        <record id="fee_type_registration" model="eacta.fee.type">
            <field name="name">Frais d'inscription</field>
            <field name="sequence">1</field>
            <field name="default_amount">1500</field>
        </record>
        <record id="fee_type_tuition" model="eacta.fee.type">
            <field name="name">Scolarité</field>
            <field name="sequence">2</field>
            <field name="default_amount">12000</field>
        </record>
        <record id="fee_type_transport" model="eacta.fee.type">
            <field name="name">Transport scolaire</field>
            <field name="sequence">3</field>
            <field name="default_amount">3000</field>
        </record>
        <record id="fee_type_canteen" model="eacta.fee.type">
            <field name="name">Cantine</field>
            <field name="sequence">4</field>
            <field name="default_amount">4000</field>
        </record>
        <record id="fee_type_activities" model="eacta.fee.type">
            <field name="name">Activités parascolaires</field>
            <field name="sequence">5</field>
            <field name="default_amount">800</field>
        </record>

    </data>
</odoo>
