<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Styles communs aux rapports NR School (limités au conteneur .eacta_report) -->
    <template id="eacta_school_report_assets" name="NR School Report Styles">
        <style>
            .eacta_report { font-size: 12px; color: #1e293b; }
            .eacta_report .eacta_report_title {
                display: flex; justify-content: space-between; align-items: flex-end;
                border-bottom: 3px solid #00285c; padding-bottom: 8px; margin-bottom: 16px;
            }
            .eacta_report .eacta_report_title h2 { margin: 0; font-weight: 700; color: #001a3d; }
            .eacta_report .eacta_report_title .eacta_report_sub { color: #64748b; font-size: 12px; }
            .eacta_report .eacta_identity {
                display: table; width: 100%; background: #f8fafc; border: 1px solid #e2e8f0;
                border-radius: 6px; padding: 10px 14px; margin-bottom: 16px;
            }
            .eacta_report .eacta_identity > div { display: table-cell; width: 33%; vertical-align: top; }
            .eacta_report .eacta_identity .eacta_label {
                color: #64748b; font-size: 10px; text-transform: uppercase; letter-spacing: .05em;
            }
            .eacta_report .eacta_identity .eacta_value { font-weight: 600; font-size: 13px; }
            .eacta_report table.eacta_table { width: 100%; border-collapse: collapse; }
            .eacta_report table.eacta_table th {
                background: #001a3d; color: #fff; font-weight: 600; padding: 6px 8px;
                font-size: 11px; text-align: left;
            }
            .eacta_report table.eacta_table td { padding: 6px 8px; border-bottom: 1px solid #e2e8f0; }
            .eacta_report table.eacta_table tr:nth-child(even) td { background: #f8fafc; }
            .eacta_report table.eacta_table .text-end { text-align: right; }
            .eacta_report table.eacta_table .text-center { text-align: center; }
            .eacta_report .eacta_fail { color: #b91c1c; font-weight: 700; }
            .eacta_report .eacta_pass { color: #047857; font-weight: 700; }
            .eacta_report .eacta_summary { display: table; width: 100%; margin-top: 18px; }
            .eacta_report .eacta_summary > div {
                display: table-cell; text-align: center; padding: 10px; border: 1px solid #e2e8f0;
            }
            .eacta_report .eacta_summary .eacta_big { font-size: 20px; font-weight: 800; color: #00285c; }
            .eacta_report .eacta_signatures { display: table; width: 100%; margin-top: 40px; }
            .eacta_report .eacta_signatures > div {
                display: table-cell; width: 50%; text-align: center; color: #64748b; height: 70px;
            }
        </style>
    </template>
</odoo>
