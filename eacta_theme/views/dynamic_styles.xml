<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Favicon et Titre officiels NR School pour toutes les pages Odoo (web.layout) -->
    <template id="eacta_theme_layout_brand" name="NR School Favicon &amp; Title" inherit_id="web.layout">
        <xpath expr="//link[@rel='shortcut icon']" position="replace">
            <link type="image/png" rel="icon" sizes="512x512" href="/eacta_school/static/src/img/nr_school_icon.png"/>
            <link type="image/png" rel="icon" sizes="192x192" href="/eacta_school/static/src/img/nr_school_icon_192.png"/>
            <link type="image/png" rel="icon" sizes="32x32" href="/eacta_school/static/src/img/nr_school_icon_32.png"/>
            <link type="image/png" rel="icon" sizes="16x16" href="/eacta_school/static/src/img/nr_school_icon_16.png"/>
            <link type="image/x-icon" rel="shortcut icon" href="/eacta_school/static/src/img/favicon.ico"/>
            <link rel="apple-touch-icon" href="/eacta_school/static/src/img/nr_school_icon.png"/>
        </xpath>
        <xpath expr="//title" position="replace">
            <title t-esc="title or 'NR School'"/>
        </xpath>
    </template>

    <!-- Variables CSS et branding injectés dans le client web -->
    <template id="eacta_theme_dynamic_styles" name="NR School Theme Dynamic Styles" inherit_id="web.webclient_bootstrap">
        <xpath expr="//meta[@name='theme-color']" position="attributes">
            <attribute name="content">#3B0A18</attribute>
        </xpath>
        <xpath expr="//link[@rel='apple-touch-icon']" position="attributes">
            <attribute name="href">/eacta_school/static/src/img/nr_school_icon.png</attribute>
        </xpath>
        <xpath expr="//t[@t-set='head_web']" position="inside">
            <link type="image/png" rel="icon" sizes="512x512" href="/eacta_school/static/src/img/nr_school_icon.png"/>
            <link type="image/png" rel="icon" sizes="192x192" href="/eacta_school/static/src/img/nr_school_icon_192.png"/>
            <link type="image/png" rel="icon" sizes="32x32" href="/eacta_school/static/src/img/nr_school_icon_32.png"/>
            <link type="image/x-icon" rel="shortcut icon" href="/eacta_school/static/src/img/favicon.ico"/>
            <t t-set="eacta_theme" t-value="request.env['eacta.theme.config'].sudo()"/>
            <t t-set="eacta_font_url" t-value="eacta_theme._get_font_url()"/>
            <link t-if="eacta_font_url" rel="preconnect" href="https://fonts.gstatic.com" crossorigin=""/>
            <link t-if="eacta_font_url" rel="stylesheet" t-att-href="eacta_font_url"/>
            <style id="eacta_theme_vars" t-out="eacta_theme._get_theme_css()"/>
        </xpath>
    </template>

    <!-- Page de connexion aux couleurs et logo de l'établissement -->
    <template id="eacta_theme_login_styles" name="NR School Theme Login" inherit_id="web.login_layout">
        <xpath expr="//img[contains(@t-attf-src, 'company_logo')]" position="attributes">
            <attribute name="t-attf-src">/eacta_school/static/src/img/nr_school_icon.png</attribute>
            <attribute name="alt">NR School Logo</attribute>
            <attribute name="style">max-height: 110px; max-width: 100%; width: auto; object-fit: contain;</attribute>
        </xpath>
        <xpath expr="//div[hasclass('container')]" position="before">
            <link type="image/png" rel="icon" sizes="512x512" href="/eacta_school/static/src/img/nr_school_icon.png"/>
            <link type="image/png" rel="icon" sizes="32x32" href="/eacta_school/static/src/img/nr_school_icon_32.png"/>
            <link type="image/x-icon" rel="shortcut icon" href="/eacta_school/static/src/img/favicon.ico"/>
            <t t-set="eacta_theme" t-value="request.env['eacta.theme.config'].sudo()"/>
            <t t-set="eacta_current" t-value="eacta_theme._get_current()"/>
            <t t-if="not eacta_current or eacta_current.brand_login">
                <t t-set="eacta_font_url" t-value="eacta_theme._get_font_url()"/>
                <link t-if="eacta_font_url" rel="stylesheet" t-att-href="eacta_font_url"/>
                <style t-out="eacta_theme._get_theme_css()"/>
                <style>
                    body.bg-100, html { min-height: 100%; }
                    body.bg-100 {
                        background:
                            radial-gradient(circle at 15% 15%, color-mix(in srgb, var(--eacta-secondary) 35%, transparent) 0, transparent 40%),
                            linear-gradient(135deg, var(--eacta-primary-ink) 0%, var(--eacta-primary) 100%) fixed !important;
                        font-family: var(--eacta-font);
                    }
                    .o_database_list {
                        max-width: 380px !important;
                        background: #fff !important;
                        border-radius: 18px !important;
                        box-shadow: 0 24px 60px rgba(0, 0, 0, .28) !important;
                        padding: .75rem .5rem;
                        margin-top: 6vh;
                    }
                    .o_database_list .btn-primary {
                        background: var(--eacta-primary) !important;
                        border-color: var(--eacta-primary) !important;
                        border-radius: 10px; font-weight: 600; padding: .6rem 1rem;
                    }
                    .o_database_list .btn-primary:hover { background: var(--eacta-primary-hover) !important; }
                    .o_database_list .form-control { border-radius: 10px; padding: .6rem .8rem; }
                    .o_database_list .form-control:focus {
                        border-color: var(--eacta-primary);
                        box-shadow: 0 0 0 3px color-mix(in srgb, var(--eacta-primary) 20%, transparent);
                    }
                    .o_database_list a { color: var(--eacta-primary); }
                </style>
            </t>
        </xpath>
    </template>

    <!-- 4. Polices & Assets pour le portail (web.frontend_layout) -->
    <template id="eacta_theme_portal_fonts" name="NR School Portal Fonts &amp; Favicon" inherit_id="web.frontend_layout" priority="25">
        <xpath expr="//head" position="inside">
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin=""/>
            <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&amp;family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap" rel="stylesheet"/>
        </xpath>
    </template>

    <!-- 5. Branding de l'en-tête et pied de page du portail (portal.frontend_layout) -->
    <template id="eacta_theme_portal_navbar" name="NR School Portal Navbar &amp; Brand" inherit_id="portal.frontend_layout" priority="25">
        <xpath expr="//a[hasclass('navbar-brand')]" position="replace">
            <a href="/my/school" class="navbar-brand d-flex align-items-center gap-2 text-decoration-none">
                <img src="/eacta_school/static/src/img/nr_school_icon.png" alt="NR School Logo" style="height: 38px; width: 38px; object-fit: contain; border-radius: 8px;"/>
                <div class="d-flex flex-column leading-tight">
                    <span class="fw-bold text-white fs-5" style="letter-spacing: -0.02em;">NR School</span>
                    <span class="small text-white-50" style="font-size: 0.72rem;">Portail Scolaire / الفضاء المدرسي</span>
                </div>
            </a>
        </xpath>
        <xpath expr="//footer" position="replace">
            <footer class="o_footer text-center py-3" style="background: #0F172A; color: #94A3B8; border-top: 3px solid #8E1B3A;">
                <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2 small">
                    <div>
                        <strong class="text-white">NR School</strong> • Système Numérique de Gestion Pédagogique &amp; Vie Scolaire
                    </div>
                    <div>
                        <span>Année scolaire 2026-2027 • Portail Familles &amp; Élèves</span>
                    </div>
                </div>
            </footer>
        </xpath>
    </template>

    <!-- 6. Titre et En-tête Mon Compte (portal.portal_layout) -->
    <template id="eacta_theme_portal_layout_header" name="NR School Portal Header" inherit_id="portal.portal_layout" priority="25">
        <xpath expr="//div[hasclass('wrapper')]//h3" position="replace">
            <div class="portal-main-heading d-flex align-items-center gap-3 my-3">
                <div class="portal-heading-icon">
                    <i class="fa fa-user-circle"></i>
                </div>
                <div>
                    <h3 class="mb-0 fw-bold portal-title-text">Mon Compte &amp; Espaces</h3>
                    <span class="text-muted small">Gestion de votre compte et accès aux services scolaires</span>
                </div>
            </div>
        </xpath>
    </template>

    <!-- 7. Carte Profil Utilisateur Latérale (portal.side_content) -->
    <template id="eacta_theme_portal_side_content" name="NR School Portal Profile Sidebar" inherit_id="portal.side_content" priority="25">
        <xpath expr="//div[contains(@t-attf-class, 'offcanvas-body') or contains(@t-attf-class, 'mt-3')]" position="replace">
            <div t-attf-class="{{'offcanvas-body' if isOffcanvas else 'mt-3 mw-100'}} portal-profile-sidebar-card">
                <!-- En-tête Profil avec Avatar Cerclé &amp; Statut -->
                <div class="portal-profile-header text-center pb-3 mb-3 border-bottom">
                    <div class="portal-profile-avatar-container mb-3 position-relative d-inline-block">
                        <t t-set="p_partner" t-value="user_id.partner_id"/>
                        <img class="portal-profile-avatar rounded-circle object-fit-cover shadow-sm"
                             t-att-src="image_data_uri(p_partner.avatar_128)"
                             alt="Avatar"
                             width="84" height="84"
                             style="border: 3.5px solid #E0A630; background: #FFF;"/>
                        <span class="portal-avatar-status-badge" title="Compte actif vérifié">
                            <i class="fa fa-check-circle"></i>
                        </span>
                    </div>
                    <h5 class="fw-bold mb-1 text-dark" t-out="user_id.name"/>
                    <div class="portal-profile-badges d-flex justify-content-center flex-wrap gap-1 mb-2">
                        <span t-if="p_partner.is_school_parent" class="badge rounded-pill bg-wine-subtle text-wine px-2 py-1 small">
                            <i class="fa fa-users me-1"></i> Parent d'élève
                        </span>
                        <span t-elif="portal_students" class="badge rounded-pill bg-wine-subtle text-wine px-2 py-1 small">
                            <i class="fa fa-graduation-cap me-1"></i> Profil Élève
                        </span>
                        <span t-else="" class="badge rounded-pill bg-secondary-subtle text-secondary px-2 py-1 small">
                            <i class="fa fa-user me-1"></i> Utilisateur Portail
                        </span>
                        <span class="badge rounded-pill bg-light text-dark border px-2 py-1 small">
                            <i class="fa fa-shield text-success me-1"></i> Vérifié
                        </span>
                    </div>
                    <p class="text-muted small mb-0">
                        <i class="fa fa-university me-1 text-warning"></i>
                        <t t-out="p_partner.company_id.name or 'NR School Casablanca'"/>
                    </p>
                </div>

                <!-- Coordonnées Détaillées avec Icônes Stylisées -->
                <div class="portal-contact-info-list mb-4">
                    <div class="portal-contact-info-item d-flex align-items-center gap-3 py-2">
                        <div class="portal-info-icon-circle">
                            <i class="fa fa-envelope text-primary"></i>
                        </div>
                        <div class="flex-grow-1 overflow-hidden">
                            <div class="text-muted text-uppercase fw-bold" style="font-size: 0.68rem; letter-spacing: 0.05em;">Adresse Email</div>
                            <div class="text-dark fw-semibold small text-truncate" t-att-title="p_partner.email or 'Non renseignée'">
                                <t t-out="p_partner.email or 'Non renseignée'"/>
                            </div>
                        </div>
                    </div>

                    <div class="portal-contact-info-item d-flex align-items-center gap-3 py-2">
                        <div class="portal-info-icon-circle">
                            <i class="fa fa-phone text-success"></i>
                        </div>
                        <div class="flex-grow-1 overflow-hidden">
                            <div class="text-muted text-uppercase fw-bold" style="font-size: 0.68rem; letter-spacing: 0.05em;">Téléphone</div>
                            <div class="text-dark fw-semibold small">
                                <t t-out="p_partner.phone or p_partner.mobile or 'Non renseigné'"/>
                            </div>
                        </div>
                    </div>

                    <div class="portal-contact-info-item d-flex align-items-start gap-3 py-2">
                        <div class="portal-info-icon-circle mt-1">
                            <i class="fa fa-map-marker text-danger"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="text-muted text-uppercase fw-bold" style="font-size: 0.68rem; letter-spacing: 0.05em;">Adresse</div>
                            <div class="text-dark small">
                                <t t-if="p_partner.street or p_partner.city">
                                    <t t-out="p_partner.street"/><t t-if="p_partner.street and p_partner.city">, </t><t t-out="p_partner.city"/>
                                    <t t-if="p_partner.country_id"> (<t t-out="p_partner.country_id.name"/>)</t>
                                </t>
                                <t t-else="">Casablanca, Maroc</t>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Actions du Profil -->
                <div class="d-grid gap-2 mb-4">
                    <a role="button" href="/my/account" class="btn btn-outline-school fw-semibold">
                        <i class="fa fa-pencil-square-o me-2"></i> Modifier mes informations
                    </a>
                    <a role="button" href="/my/security" class="btn btn-light border text-muted fw-semibold small">
                        <i class="fa fa-lock me-2"></i> Sécurité &amp; Mot de passe
                    </a>
                </div>

                <!-- Boîte d'Assistance Scolarité -->
                <div class="portal-sidebar-helpbox p-3 rounded-3 text-center">
                    <div class="fw-bold text-dark small mb-1">
                        <i class="fa fa-headset text-warning me-1"></i> Assistance Scolarité
                    </div>
                    <p class="text-muted mb-2" style="font-size: 0.78rem;">
                        Une question sur la scolarité ou vos démarches ?
                    </p>
                    <a href="mailto:contact@nrschool.ma" class="btn btn-sm btn-light border rounded-pill px-3 py-1 text-dark fw-bold" style="font-size: 0.75rem;">
                        <i class="fa fa-paper-plane me-1 text-primary"></i> Contacter l'établissement
                    </a>
                </div>

                <div name="portal_contact" class="o_my_contact mt-3" t-if="sales_user">
                    <t t-call="portal.portal_contact"/>
                </div>
            </div>
        </xpath>
    </template>

    <!-- 8. En-tête Connexion & Sécurité (portal.portal_my_security) -->
    <template id="eacta_theme_portal_my_security" name="NR School Connexion &amp; Sécurité" inherit_id="portal.portal_my_security" priority="25">
        <xpath expr="//div[hasclass('d-flex') and hasclass('gap-2') and hasclass('my-3')]" position="replace">
            <div class="portal-security-hero mb-4">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 position-relative" style="z-index: 2;">
                    <div class="d-flex align-items-center gap-3">
                        <a href="/my" class="btn btn-portal-back" title="Retour au portail">
                            <i class="fa fa-arrow-left"></i>
                        </a>
                        <div class="portal-security-icon-box">
                            <i class="fa fa-shield"></i>
                        </div>
                        <div>
                            <div class="d-flex align-items-center flex-wrap gap-2 mb-1">
                                <span class="portal-badge-gold">
                                    <i class="fa fa-lock me-1"></i> Espace Sécurisé
                                </span>
                                <span class="portal-badge-glass d-none d-sm-inline-block">
                                    NR School Casablanca
                                </span>
                            </div>
                            <h2 class="portal-security-title mb-0">Connexion &amp; Sécurité</h2>
                            <p class="portal-security-subtext mb-0">
                                Gestion des mots de passe, sessions actives et authentification
                            </p>
                        </div>
                    </div>
                    <div>
                        <a href="/my" class="btn btn-portal-gold shadow-sm">
                            <i class="fa fa-user me-1"></i> Mon Compte
                        </a>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <!-- 9. En-tête et Cadre Informations & Coordonnées (portal.portal_my_details) -->
    <template id="eacta_theme_portal_my_details" name="NR School Coordonnées &amp; Informations" inherit_id="portal.portal_my_details" priority="25">
        <xpath expr="//form[@action='/my/account']" position="before">
            <div class="portal-account-hero mb-4">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 position-relative" style="z-index: 2;">
                    <div class="d-flex align-items-center gap-3">
                        <a href="/my" class="btn btn-portal-back" title="Retour au portail">
                            <i class="fa fa-arrow-left"></i>
                        </a>
                        <div class="portal-account-icon-box">
                            <i class="fa fa-user-circle"></i>
                        </div>
                        <div>
                            <div class="d-flex align-items-center flex-wrap gap-2 mb-1">
                                <span class="portal-badge-gold">
                                    <i class="fa fa-id-card me-1"></i> Coordonnées
                                </span>
                                <span class="portal-badge-glass d-none d-sm-inline-block">
                                    NR School Casablanca
                                </span>
                            </div>
                            <h2 class="portal-account-title mb-0">Informations &amp; Coordonnées</h2>
                            <p class="portal-account-subtext mb-0">
                                Mise à jour de vos données pour la réception des bulletins et alertes scolaires
                            </p>
                        </div>
                    </div>
                    <div>
                        <a href="/my" class="btn btn-portal-gold shadow-sm">
                            <i class="fa fa-arrow-left me-1"></i> Mon Compte
                        </a>
                    </div>
                </div>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('o_portal_details')]" position="attributes">
            <attribute name="class">row o_portal_details g-4</attribute>
        </xpath>
        <xpath expr="//div[hasclass('o_portal_details')]/div[hasclass('col-lg-8')]" position="after">
            <div class="col-lg-4">
                <div class="portal-account-sidecard p-4 rounded-4 bg-white border shadow-sm">
                    <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                        <span class="portal-info-icon-circle">
                            <i class="fa fa-info-circle text-primary"></i>
                        </span>
                        <h5 class="mb-0 fw-bold text-dark">Utilisation de vos données</h5>
                    </div>
                    <div class="d-flex flex-column gap-3 small">
                        <div class="d-flex gap-2">
                            <span class="text-success fs-5 flex-shrink-0"><i class="fa fa-whatsapp"></i></span>
                            <div>
                                <strong class="d-block text-dark">Alertes SMS &amp; WhatsApp</strong>
                                <span class="text-muted">Votre téléphone portable reçoit instantanément les alertes de retard, absences et urgences.</span>
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            <span class="text-primary fs-5 flex-shrink-0"><i class="fa fa-envelope-open"></i></span>
                            <div>
                                <strong class="d-block text-dark">Bulletins &amp; Relevés</strong>
                                <span class="text-muted">Votre email reçoit automatiquement les relevés de notes et convocations officielles.</span>
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            <span class="text-warning fs-5 flex-shrink-0"><i class="fa fa-lock"></i></span>
                            <div>
                                <strong class="d-block text-dark">Confidentialité CNDP</strong>
                                <span class="text-muted">Données strictement protégées et confidentielles, réservées à l'usage scolaire exclusif.</span>
                            </div>
                        </div>
                    </div>
                    <div class="mt-4 pt-3 border-top text-center">
                        <span class="small text-muted d-block mb-2">Besoin de modifier le nom officiel d'un élève ?</span>
                        <a href="mailto:contact@nrschool.ma" class="btn btn-sm btn-outline-school rounded-pill px-3">
                            <i class="fa fa-paper-plane me-1"></i> Contacter l'administration
                        </a>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
