<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 1. En-tête PWA & Meta Tags Mobiles (web.frontend_layout) -->
    <template id="pwa_frontend_meta" name="NR School PWA Meta &amp; Manifest" inherit_id="web.frontend_layout" priority="20">
        <xpath expr="//head" position="inside">
            <!-- PWA Web App Manifest -->
            <link rel="manifest" href="/school/manifest.webmanifest"/>

            <!-- Meta tags pour écran d'accueil Android &amp; iOS -->
            <meta name="mobile-web-app-capable" content="yes"/>
            <meta name="apple-mobile-web-app-capable" content="yes"/>
            <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
            <meta name="apple-mobile-web-app-title" content="NR School"/>
            <meta name="application-name" content="NR School"/>
            <meta name="theme-color" content="#8E1B3A"/>

            <!-- Icônes pour iOS Safari &amp; PWA -->
            <link rel="apple-touch-icon" sizes="192x192" href="/eacta_theme/static/src/img/nr_school_icon_192.png"/>
            <link rel="apple-touch-icon" sizes="512x512" href="/eacta_theme/static/src/img/nr_school_icon_512.png"/>
        </xpath>
    </template>

    <!-- 2. Barre de Navigation Mobile Inférieure &amp; Bannière d'Installation (portal.frontend_layout) -->
    <template id="pwa_portal_mobile_elements" name="NR School Mobile Bottom Nav &amp; Install Banner" inherit_id="portal.frontend_layout" priority="30">
        <xpath expr="//body" position="inside">

            <!-- Barre de navigation mobile inférieure (Fixée en bas sur écrans <= 768px) -->
            <nav class="nrschool-mobile-nav" aria-label="Navigation mobile">
                <a href="/my" class="nrschool-mobile-nav-item" id="nav-item-home">
                    <i class="fa fa-home"></i>
                    <span>Accueil</span>
                </a>
                <a href="/my/school" class="nrschool-mobile-nav-item" id="nav-item-school">
                    <i class="fa fa-graduation-cap"></i>
                    <span>Scolarité</span>
                </a>
                <a href="/my/security" class="nrschool-mobile-nav-item" id="nav-item-security">
                    <i class="fa fa-shield"></i>
                    <span>Sécurité</span>
                </a>
                <a href="/my/account" class="nrschool-mobile-nav-item" id="nav-item-account">
                    <i class="fa fa-user-circle"></i>
                    <span>Compte</span>
                </a>
            </nav>

            <!-- Bannière d'installation PWA Flottante -->
            <div id="nrschool-pwa-install-banner" class="nrschool-pwa-banner d-none" role="dialog" aria-live="polite">
                <div class="d-flex align-items-center justify-content-between gap-3">
                    <img src="/eacta_theme/static/src/img/nr_school_icon_192.png" alt="NR School Icon" class="nrschool-pwa-banner-icon flex-shrink-0"/>
                    <div class="flex-grow-1">
                        <div class="nrschool-pwa-banner-title">Installer NR School</div>
                        <p class="nrschool-pwa-banner-desc">Accédez directement à vos bulletins, événements et suivi scolaire depuis votre écran d'accueil.</p>
                    </div>
                </div>
                <div class="d-flex align-items-center justify-content-end gap-2 mt-3 pt-2 border-top">
                    <button type="button" id="nrschool-pwa-dismiss-btn" class="btn-pwa-dismiss">Plus tard</button>
                    <button type="button" id="nrschool-pwa-install-btn" class="btn-pwa-install">
                        <i class="fa fa-download me-1"></i> Installer l'App
                    </button>
                </div>
            </div>

            <!-- Modal Guide Installation iOS Safari -->
            <div class="modal fade" id="nrschool-pwa-ios-modal" tabindex="-1" aria-labelledby="iosModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content rounded-4 border-0 shadow">
                        <div class="modal-header border-0 pb-0">
                            <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2" id="iosModalLabel">
                                <i class="fa fa-apple text-dark"></i>
                                Installer sur iPhone ou iPad
                            </h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body pt-3">
                            <div class="text-center mb-3">
                                <img src="/eacta_theme/static/src/img/nr_school_icon_192.png" alt="NR School" width="64" height="64" class="rounded-3 shadow-sm mb-2"/>
                                <h6 class="fw-bold mb-0">Application NR School</h6>
                                <span class="text-muted small">Portail Familles &amp; Scolarité</span>
                            </div>
                            <ol class="list-group list-group-numbered list-group-flush small">
                                <li class="list-group-item d-flex align-items-start gap-2 border-0 px-0">
                                    <div class="ms-2 me-auto">
                                        Dans <strong>Safari</strong>, appuyez sur l'icône de partage <strong>[ <i class="fa fa-share-square-o"></i> ]</strong> dans la barre du bas.
                                    </div>
                                </li>
                                <li class="list-group-item d-flex align-items-start gap-2 border-0 px-0">
                                    <div class="ms-2 me-auto">
                                        Faites défiler le menu et sélectionnez <strong>« Sur l'écran d'accueil »</strong> (icône <i class="fa fa-plus-square"></i>).
                                    </div>
                                </li>
                                <li class="list-group-item d-flex align-items-start gap-2 border-0 px-0">
                                    <div class="ms-2 me-auto">
                                        Appuyez sur <strong>« Ajouter »</strong> en haut à droite pour profiter d'une expérience plein écran !
                                    </div>
                                </li>
                            </ol>
                        </div>
                        <div class="modal-footer border-0 pt-0">
                            <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Compris</button>
                        </div>
                    </div>
                </div>
            </div>

        </xpath>
    </template>

    <!-- 3. Page Hors-Ligne Stylisée (portal_pwa_offline) -->
    <template id="portal_pwa_offline" name="NR School PWA Offline">
        &lt;!DOCTYPE html&gt;
        <html lang="fr">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no"/>
                <title>Hors-ligne • NR School</title>
                <link rel="icon" href="/eacta_theme/static/src/img/favicon.ico"/>
                <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&amp;display=swap"/>
                <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css"/>
                <style>
                    body {
                        margin: 0;
                        padding: 0;
                        background: #F8FAFC;
                        font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        min-height: 100vh;
                        color: #1E293B;
                    }
                    .offline-card {
                        max-width: 440px;
                        margin: 20px;
                        background: #FFFFFF;
                        border-radius: 24px;
                        border: 1px solid rgba(142, 27, 58, 0.12);
                        box-shadow: 0 20px 48px rgba(0, 0, 0, 0.08);
                        padding: 2.5rem 2rem;
                        text-align: center;
                    }
                    .offline-icon {
                        width: 80px;
                        height: 80px;
                        border-radius: 50%;
                        background: rgba(142, 27, 58, 0.08);
                        color: #8E1B3A;
                        display: inline-flex;
                        align-items: center;
                        justify-content: center;
                        font-size: 2.4rem;
                        margin-bottom: 1.5rem;
                    }
                    h2 {
                        font-size: 1.4rem;
                        font-weight: 800;
                        margin-bottom: 0.5rem;
                        color: #0F172A;
                    }
                    p {
                        color: #64748B;
                        font-size: 0.9rem;
                        line-height: 1.5;
                        margin-bottom: 2rem;
                    }
                    .btn-refresh {
                        display: block;
                        width: 100%;
                        background: linear-gradient(135deg, #8E1B3A 0%, #B82A4D 100%);
                        color: #FFFFFF;
                        font-weight: 700;
                        font-size: 0.95rem;
                        border: none;
                        border-radius: 12px;
                        padding: 12px 20px;
                        box-shadow: 0 4px 14px rgba(142, 27, 58, 0.28);
                        cursor: pointer;
                        text-decoration: none;
                        box-sizing: border-box;
                    }
                    .btn-home {
                        display: block;
                        margin-top: 12px;
                        color: #64748B;
                        font-size: 0.85rem;
                        text-decoration: none;
                    }
                </style>
            </head>
            <body>
                <div class="offline-card">
                    <div class="offline-icon">
                        <i class="fa fa-wifi"></i>
                    </div>
                    <h2>Connexion Interrompue</h2>
                    <p>
                        Vous êtes actuellement hors-ligne. L'application NR School se reconnectera automatiquement dès que votre réseau sera rétabli.
                    </p>
                    <button class="btn-refresh" onclick="window.location.reload();">
                        <i class="fa fa-refresh me-2"></i> Actualiser la page
                    </button>
                    <a href="/my" class="btn-home">Retour à l'accueil</a>
                </div>
            </body>
        </html>
    </template>

</odoo>
