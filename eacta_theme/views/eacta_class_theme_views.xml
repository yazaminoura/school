<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Amélioration visuelle de la vue Kanban des classes -->
    <record id="view_eacta_class_kanban_theme" model="ir.ui.view">
        <field name="name">eacta.class.kanban.theme</field>
        <field name="model">eacta.class</field>
        <field name="inherit_id" ref="eacta_school.view_eacta_class_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//templates" position="replace">
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click eacta_card_custom">
                            <!-- En-tête : Nom de classe + Année scolaire -->
                            <div class="eacta_card_header">
                                <h5 class="eacta_card_title mb-0">
                                    <field name="name"/>
                                </h5>
                                <span class="eacta_pill_badge eacta_badge_primary">
                                    <i class="fa fa-calendar-alt"/> <field name="year"/>
                                </span>
                            </div>

                            <!-- Niveau & Enseignant -->
                            <div class="eacta_card_body">
                                <div class="d-flex align-items-center gap-2">
                                    <span t-if="record.level.raw_value == 'primary'" class="eacta_pill_badge eacta_badge_enrolled">
                                        Primaire
                                    </span>
                                    <span t-if="record.level.raw_value == 'secondary'" class="eacta_pill_badge eacta_badge_accent">
                                        Secondaire
                                    </span>
                                    <span t-if="record.level.raw_value == 'higher'" class="eacta_pill_badge eacta_badge_graduated">
                                        Supérieur
                                    </span>
                                </div>
                                <div t-if="record.teacher_id.raw_value" class="text-muted d-flex align-items-center gap-2 small mt-1">
                                    <i class="fa fa-chalkboard-teacher text-primary"/>
                                    <span>Prof: <field name="teacher_id"/></span>
                                </div>

                                <!-- Jauge visuelle de capacité -->
                                <div class="eacta_capacity_meter mt-2">
                                    <div class="d-flex justify-content-between small text-muted">
                                        <span>Effectif</span>
                                        <span class="fw-bold"><t t-esc="record.student_ids.raw_value ? record.student_ids.raw_value.length : 0"/> / <field name="capacity"/></span>
                                    </div>
                                    <div class="eacta_meter_bar">
                                        <div class="eacta_meter_fill"
                                             t-attf-style="width: #{record.capacity.raw_value ? Math.min(100, Math.round(((record.student_ids.raw_value ? record.student_ids.raw_value.length : 0) / record.capacity.raw_value) * 100)) : 0}%"/>
                                    </div>
                                </div>
                            </div>

                            <!-- Pied de carte : Bouton d'action direct -->
                            <div class="eacta_card_footer">
                                <span class="text-muted small">
                                    <i class="fa fa-users text-primary"/>
                                    <t t-esc="record.student_ids.raw_value ? record.student_ids.raw_value.length : 0"/> élèves
                                </span>
                                <button name="action_view_courses"
                                        type="object"
                                        class="btn btn-sm btn-outline-primary rounded-pill">
                                    <i class="fa fa-book-open"/> Voir cours
                                </button>
                            </div>
                        </div>
                    </t>
                </templates>
            </xpath>
        </field>
    </record>
</odoo>
